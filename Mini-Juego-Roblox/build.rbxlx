          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">M1_ReflexQTE</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Network = require(ReplicatedStorage.Shared.Network)
local MinigameLevelsData = require(ReplicatedStorage.Shared.Config.MinigameLevelsData)

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui

local M1_ReflexQTE = {}

local activeScreenGui: ScreenGui? = nil
local isRunning = false
local FREEZE_ACTION_NAME = "M1_MovementFreezeAction"
local currentKeyProcessor: ((string) -> ())? = nil

function M1_ReflexQTE.ProcessKey(key: string)
	if currentKeyProcessor then
		currentKeyProcessor(key)
	end
end

-- Procedural SFX helper for Audio Pitch Scaling (Dopamine boost)
local function PlayDopamineChime(comboIndex: number)
	task.spawn(function()
		local sound = Instance.new("Sound")
		sound.Name = "QTE_Chime"
		sound.SoundId = "rbxassetid://6895079853" -- Crisp feedback chime
		sound.Volume = 0.75
		-- Audio pitch scaling: frequency ascends as streak increases
		sound.PlaybackSpeed = math.clamp(1.0 + (comboIndex * 0.12), 1.0, 2.2)
		sound.Parent = Workspace
		sound:Play()
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		task.delay(1.5, function()
			if sound and sound.Parent then
				sound:Destroy()
			end
		end)
	end)
end

local function PlayFailureBuzzer()
	task.spawn(function()
		local sound = Instance.new("Sound")
		sound.Name = "QTE_Fail"
		sound.SoundId = "rbxassetid://9114223170" -- Low error thud
		sound.Volume = 0.8
		sound.PlaybackSpeed = 0.7
		sound.Parent = Workspace
		sound:Play()
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		task.delay(1.5, function()
			if sound and sound.Parent then
				sound:Destroy()
			end
		end)
	end)
end

function M1_ReflexQTE.StartMinigame(
	difficulty: number,
	token: string,
	sequence: { string },
	distractors: { [number]: boolean },
	onCompleted: (boolean, string?) -> ()
)
	if isRunning then
		return
	end
	isRunning = true

	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	local levelData = MinigameLevelsData.GetLevel(1, difficulty)
	local qteConfig = levelData and levelData.Specific.QTE or { SequenceLength = #sequence, WindowPerKey = 2.5, DistractorCount = 0 }

	-- 1. FREEZE CHARACTER MOVEMENT SO PRESSING WASD/SPACE DOES NOT MOVE THE CHARACTER
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?

	local prevWalkSpeed = if hum then hum.WalkSpeed else 16
	local prevJumpPower = if hum then hum.JumpPower else 50
	local prevJumpHeight = if hum then hum.JumpHeight else 7.2
	local wasAnchored = if hrp then hrp.Anchored else false

	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
	end
	if hrp then
		hrp.Anchored = true
	end

	local ProcessInputFunc: ((string) -> ())? = nil

	-- Intercept QTE keys directly and sink movement keys
	ContextActionService:BindActionAtPriority(
		FREEZE_ACTION_NAME,
		function(_actionName, inputState, inputObject)
			if inputState == Enum.UserInputState.Begin and ProcessInputFunc then
				local k = inputObject.KeyCode
				local keyStr: string? = nil
				if k == Enum.KeyCode.W then
					keyStr = "W"
				elseif k == Enum.KeyCode.A then
					keyStr = "A"
				elseif k == Enum.KeyCode.S then
					keyStr = "S"
				elseif k == Enum.KeyCode.D then
					keyStr = "D"
				elseif k == Enum.KeyCode.E then
					keyStr = "E"
				elseif k == Enum.KeyCode.Q then
					keyStr = "Q"
				elseif k == Enum.KeyCode.Space then
					keyStr = "Space"
				end
				if keyStr then
					ProcessInputFunc(keyStr)
				end
			end
			return Enum.ContextActionResult.Sink
		end,
		false,
		Enum.ContextActionPriority.High.Value + 300,
		Enum.KeyCode.W,
		Enum.KeyCode.A,
		Enum.KeyCode.S,
		Enum.KeyCode.D,
		Enum.KeyCode.E,
		Enum.KeyCode.Q,
		Enum.KeyCode.Space,
		Enum.KeyCode.Up,
		Enum.KeyCode.Down,
		Enum.KeyCode.Left,
		Enum.KeyCode.Right
	)

	local function RestoreMovement()
		ContextActionService:UnbindAction(FREEZE_ACTION_NAME)
		currentKeyProcessor = nil
		if hum and hum.Parent then
			hum.WalkSpeed = prevWalkSpeed
			hum.JumpPower = prevJumpPower
			hum.JumpHeight = prevJumpHeight
		end
		if hrp and hrp.Parent then
			hrp.Anchored = wasAnchored
		end
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "M1_ReflexQTE_Gui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
	activeScreenGui = screenGui

	-- Container Frame (responsive for Mobile and PC)
	local container = Instance.new("Frame")
	container.Name = "QTEContainer"
	if isMobile then
		container.Size = UDim2.fromScale(0.88, 0.74)
		container.Position = UDim2.fromScale(0.06, 0.13)
	else
		container.Size = UDim2.fromScale(0.44, 0.54)
		container.Position = UDim2.fromScale(0.28, 0.23)
	end
	container.BackgroundColor3 = Color3.fromRGB(12, 16, 26)
	container.BorderSizePixel = 0
	container.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = container

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 220, 255)
	stroke.Thickness = 2.5
	stroke.Parent = container

	-- Header / Title
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(1, 0.12)
	titleLabel.Position = UDim2.fromScale(0, 0.02)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = string.format("⚡ MÁQUINA 1: REFLEJOS QTE [NIVEL %d] ⚡", difficulty)
	titleLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
	titleLabel.TextScaled = true
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Parent = container

	-- Combo & Streak Badge (Dopamine Trigger)
	local comboBadge = Instance.new("TextLabel")
	comboBadge.Name = "ComboBadge"
	comboBadge.Size = UDim2.fromScale(0.4, 0.08)
	comboBadge.Position = UDim2.fromScale(0.3, 0.13)
	comboBadge.BackgroundTransparency = 1
	comboBadge.Text = "RACHA: x0 🔥"
	comboBadge.TextColor3 = Color3.fromRGB(255, 215, 0)
	comboBadge.TextScaled = true
	comboBadge.Font = Enum.Font.GothamBlack
	comboBadge.Parent = container

	-- Key prompt display card
	local keyCard = Instance.new("Frame")
	keyCard.Name = "KeyCard"
	keyCard.Size = if isMobile then UDim2.fromScale(0.46, 0.28) else UDim2.fromScale(0.42, 0.30)
	keyCard.Position = if isMobile then UDim2.fromScale(0.27, 0.21) else UDim2.fromScale(0.29, 0.21)
	keyCard.BackgroundColor3 = Color3.fromRGB(22, 28, 42)
	keyCard.BorderSizePixel = 0
	keyCard.Parent = container

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 12)
	cardCorner.Parent = keyCard

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = Color3.fromRGB(60, 120, 200)
	cardStroke.Thickness = 2.5
	cardStroke.Parent = keyCard

	local keyLabel = Instance.new("TextLabel")
	keyLabel.Name = "KeyText"
	keyLabel.Size = UDim2.fromScale(1, 0.68)
	keyLabel.Position = UDim2.fromScale(0, 0.02)
	keyLabel.BackgroundTransparency = 1
	keyLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	keyLabel.TextScaled = true
	keyLabel.Font = Enum.Font.GothamBlack
	keyLabel.Parent = keyCard

	local hintLabel = Instance.new("TextLabel")
	hintLabel.Name = "HintText"
	hintLabel.Size = UDim2.fromScale(1, 0.25)
	hintLabel.Position = UDim2.fromScale(0, 0.7)
	hintLabel.BackgroundTransparency = 1
	hintLabel.Text = "¡PRESIONA LA TECLA!"
	hintLabel.TextColor3 = Color3.fromRGB(180, 210, 240)
	hintLabel.TextScaled = true
	hintLabel.Font = Enum.Font.GothamBold
	hintLabel.Parent = keyCard

	-- Timer bar
	local timerBarBg = Instance.new("Frame")
	timerBarBg.Name = "TimerBarBg"
	timerBarBg.Size = UDim2.fromScale(0.85, 0.05)
	timerBarBg.Position = if isMobile then UDim2.fromScale(0.075, 0.50) else UDim2.fromScale(0.075, 0.53)
	timerBarBg.BackgroundColor3 = Color3.fromRGB(25, 30, 45)
	timerBarBg.BorderSizePixel = 0
	timerBarBg.Parent = container

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 6)
	barCorner.Parent = timerBarBg

	local timerFill = Instance.new("Frame")
	timerFill.Name = "TimerFill"
	timerFill.Size = UDim2.fromScale(1, 1)
	timerFill.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
	timerFill.BorderSizePixel = 0
	timerFill.Parent = timerBarBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 6)
	fillCorner.Parent = timerFill

	-- Interactive Touch/Click Button Pad
	local touchPad = Instance.new("Frame")
	touchPad.Name = "TouchPad"
	if isMobile then
		touchPad.Size = UDim2.fromScale(0.92, 0.40)
		touchPad.Position = UDim2.fromScale(0.04, 0.57)
	else
		touchPad.Size = UDim2.fromScale(0.92, 0.36)
		touchPad.Position = UDim2.fromScale(0.04, 0.60)
	end
	touchPad.BackgroundTransparency = 1
	touchPad.Parent = container

	-- Ergonomic 2-row layout: Row 1 = Q, W, E, Space | Row 2 = A, S, D
	local registeredButtons: { [string]: TextButton } = {}

	local row1Keys = { "Q", "W", "E", "Space" }
	local row2Keys = { "A", "S", "D" }

	local function CreateTouchButton(name: string, posX: number, posY: number, sizeX: number, sizeY: number)
		local btn = Instance.new("TextButton")
		btn.Name = "Btn_" .. name
		btn.Size = UDim2.fromScale(sizeX, sizeY)
		btn.Position = UDim2.fromScale(posX, posY)
		btn.BackgroundColor3 = if name == "Space" then Color3.fromRGB(35, 75, 115) else Color3.fromRGB(30, 42, 60)
		btn.TextColor3 = Color3.fromRGB(240, 245, 255)
		btn.Text = if name == "Space" then "␣ ESPACIO" else name
		btn.TextScaled = true
		btn.Font = Enum.Font.GothamBold
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = true

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(0, 8)
		bCorner.Parent = btn

		local bStroke = Instance.new("UIStroke")
		bStroke.Color = Color3.fromRGB(0, 180, 220)
		bStroke.Thickness = 1.5
		bStroke.Parent = btn

		btn.Parent = touchPad
		registeredButtons[name] = btn
	end

	-- Row 1: Q, W, E, Space
	for i, k in ipairs(row1Keys) do
		local width = if k == "Space" then 0.32 else 0.19
		local posX = (i - 1) * 0.22
		if k == "Space" then
			posX = 3 * 0.22
		end
		CreateTouchButton(k, posX, 0.04, width, 0.44)
	end

	-- Row 2: A, S, D
	for i, k in ipairs(row2Keys) do
		local width = 0.28
		local posX = 0.06 + (i - 1) * 0.31
		CreateTouchButton(k, posX, 0.52, width, 0.44)
	end

	-- Gameplay variables
	local currentStep = 1
	local comboStreak = 0
	local collectedInputs: { string } = {}
	local pressedTraps = false
	local startTime = os.clock()
	local stepStartTime = os.clock()

	-- Anti-rebote debounce filters
	local lastInputTimestamp = 0.0
	local lastAcceptedKey = ""
	local MIN_DEBOUNCE_SAME_KEY = 0.22
	local MIN_STEP_TRANSITION_COOLDOWN = 0.08

	local inputConn: RBXScriptConnection? = nil
	local buttonConns: { RBXScriptConnection } = {}

	local function CleanupConnections()
		RestoreMovement()
		currentKeyProcessor = nil
		ProcessInputFunc = nil
		if inputConn then
			inputConn:Disconnect()
			inputConn = nil
		end
		for _, conn in ipairs(buttonConns) do
			conn:Disconnect()
		end
		table.clear(buttonConns)
	end

	local function HighlightTargetButton(target: string, isTrap: boolean)
		for btnKey, btn in pairs(registeredButtons) do
			local bStroke = btn:FindFirstChildOfClass("UIStroke")
			if btnKey == target then
				if isTrap then
					btn.BackgroundColor3 = Color3.fromRGB(120, 25, 25)
					if bStroke then
						bStroke.Color = Color3.fromRGB(255, 60, 60)
					end
				else
					btn.BackgroundColor3 = Color3.fromRGB(0, 140, 180)
					if bStroke then
						bStroke.Color = Color3.fromRGB(0, 255, 220)
					end
				end
			else
				btn.BackgroundColor3 = if btnKey == "Space" then Color3.fromRGB(35, 75, 115) else Color3.fromRGB(30, 42, 60)
				if bStroke then
					bStroke.Color = Color3.fromRGB(0, 180, 220)
				end
			end
		end
	end

	local function ShowAutoAdvanceBanner(zoneUnlocked: number)
		local toastGui = Instance.new("ScreenGui")
		toastGui.Name = "AutoAdvanceToast"
		toastGui.ResetOnSpawn = false
		toastGui.Parent = playerGui

		local banner = Instance.new("Frame")
		banner.Name = "ToastBanner"
		banner.Size = UDim2.fromScale(0.56, 0.08)
		banner.Position = UDim2.fromScale(0.22, 0.04)
		banner.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
		banner.BorderSizePixel = 0
		banner.Parent = toastGui

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(0, 10)
		bCorner.Parent = banner

		local bStroke = Instance.new("UIStroke")
		bStroke.Color = Color3.fromRGB(0, 240, 255)
		bStroke.Thickness = 2.5
		bStroke.Parent = banner

		local bText = Instance.new("TextLabel")
		bText.Size = UDim2.fromScale(1, 1)
		bText.BackgroundTransparency = 1
		bText.Text = string.format("🏆 ¡SALA SUPERADA! >> AVANZANDO A SALA %d (+25 CRÉDITOS)", zoneUnlocked)
		bText.TextColor3 = Color3.fromRGB(255, 215, 0)
		bText.TextScaled = true
		bText.Font = Enum.Font.GothamBlack
		bText.Parent = banner

		task.delay(2.5, function()
			if toastGui and toastGui.Parent then
				local tw = TweenService:Create(banner, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
				tw:Play()
				task.wait(0.4)
				toastGui:Destroy()
			end
		end)
	end

	local function ShowFailureModal(reasonText: string)
		isRunning = false
		CleanupConnections()
		PlayFailureBuzzer()

		titleLabel.Visible = false
		comboBadge.Visible = false
		keyCard.Visible = false
		timerBarBg.Visible = false
		touchPad.Visible = false

		local failFrame = Instance.new("Frame")
		failFrame.Name = "FailFrame"
		failFrame.Size = UDim2.fromScale(1, 1)
		failFrame.BackgroundTransparency = 1
		failFrame.Parent = container

		local fTitle = Instance.new("TextLabel")
		fTitle.Name = "FailTitle"
		fTitle.Size = UDim2.fromScale(0.94, 0.18)
		fTitle.Position = UDim2.fromScale(0.03, 0.08)
		fTitle.BackgroundTransparency = 1
		fTitle.Text = "❌ ¡INTENTO FALLIDO! ❌"
		fTitle.TextColor3 = Color3.fromRGB(255, 60, 60)
		fTitle.TextScaled = true
		fTitle.Font = Enum.Font.GothamBlack
		fTitle.Parent = failFrame

		local fReason = Instance.new("TextLabel")
		fReason.Name = "FailReason"
		fReason.Size = UDim2.fromScale(0.88, 0.26)
		fReason.Position = UDim2.fromScale(0.06, 0.30)
		fReason.BackgroundColor3 = Color3.fromRGB(24, 18, 22)
		fReason.Text = reasonText
		fReason.TextColor3 = Color3.fromRGB(255, 180, 180)
		fReason.TextScaled = true
		fReason.Font = Enum.Font.GothamMedium
		fReason.BorderSizePixel = 0
		fReason.Parent = failFrame

		local frCorner = Instance.new("UICorner")
		frCorner.CornerRadius = UDim.new(0, 8)
		frCorner.Parent = fReason

		local btnRetry = Instance.new("TextButton")
		btnRetry.Name = "BtnRetry"
		btnRetry.Size = UDim2.fromScale(0.42, 0.18)
		btnRetry.Position = UDim2.fromScale(0.06, 0.65)
		btnRetry.BackgroundColor3 = Color3.fromRGB(0, 160, 200)
		btnRetry.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnRetry.Text = "🔄 REINTENTAR"
		btnRetry.TextScaled = true
		btnRetry.Font = Enum.Font.GothamBold
		btnRetry.BorderSizePixel = 0
		btnRetry.Parent = failFrame

		local brCorner = Instance.new("UICorner")
		brCorner.CornerRadius = UDim.new(0, 8)
		brCorner.Parent = btnRetry

		btnRetry.Activated:Connect(function()
			if activeScreenGui then
				activeScreenGui:Destroy()
				activeScreenGui = nil
			end
			local captureRemote = Network.GetRemote("RequestCapture")
			captureRemote:FireServer(1, difficulty)
		end)

		local btnExit = Instance.new("TextButton")
		btnExit.Name = "BtnExit"
		btnExit.Size = UDim2.fromScale(0.42, 0.18)
		btnExit.Position = UDim2.fromScale(0.52, 0.65)
		btnExit.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
		btnExit.TextColor3 = Color3.fromRGB(220, 230, 245)
		btnExit.Text = "🚪 SALIR"
		btnExit.TextScaled = true
		btnExit.Font = Enum.Font.GothamBold
		btnExit.BorderSizePixel = 0
		btnExit.Parent = failFrame

		local beCorner = Instance.new("UICorner")
		beCorner.CornerRadius = UDim.new(0, 8)
		beCorner.Parent = btnExit

		btnExit.Activated:Connect(function()
			if activeScreenGui then
				activeScreenGui:Destroy()
				activeScreenGui = nil
			end
		end)
	end

	local function ShowStep(idx: number)
		if idx > #sequence then
			-- Completed all steps successfully!
			isRunning = false
			CleanupConnections()
			RestoreMovement()
			local totalTime = os.clock() - startTime

			-- Victory fanfare
			PlayDopamineChime(sequence and #sequence + 2 or 5)

			-- Authoritative Server Submission
			local submitRemote = Network.GetRemote("SubmitMinigameResult")
			submitRemote:FireServer(1, difficulty, totalTime, token, {
				Inputs = collectedInputs,
				PressedTraps = pressedTraps,
			})

			onCompleted(not pressedTraps, if pressedTraps then "Trampa activada" else nil)

			if activeScreenGui then
				activeScreenGui:Destroy()
				activeScreenGui = nil
			end

			local nextZoneNum = difficulty == 1 and 2 or (difficulty + 1)
			ShowAutoAdvanceBanner(nextZoneNum)
			return
		end

		stepStartTime = os.clock()
		local targetKey = sequence[idx]
		local isTrap = distractors[idx] == true

		keyLabel.Text = if targetKey == "Space" then "ESPACIO" else targetKey
		HighlightTargetButton(targetKey, isTrap)

		if isTrap then
			keyCard.BackgroundColor3 = Color3.fromRGB(110, 20, 20)
			cardStroke.Color = Color3.fromRGB(255, 50, 50)
			hintLabel.Text = "¡TRAMPA! ¡NO PRESIONAR!"
			hintLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			timerFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		else
			keyCard.BackgroundColor3 = Color3.fromRGB(22, 28, 42)
			cardStroke.Color = Color3.fromRGB(0, 200, 255)
			hintLabel.Text = "¡PRESIONA LA TECLA!"
			hintLabel.TextColor3 = Color3.fromRGB(180, 210, 240)
			timerFill.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
		end

		-- Visual Pulse Tween
		keyCard.Size = if isMobile then UDim2.fromScale(0.49, 0.30) else UDim2.fromScale(0.45, 0.32)
		local tween = TweenService:Create(keyCard, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = if isMobile then UDim2.fromScale(0.46, 0.28) else UDim2.fromScale(0.42, 0.30)
		})
		tween:Play()
	end

	local function ProcessInput(inputKey: string)
		if not isRunning then
			return
		end

		local now = os.clock()

		-- 1. Anti-rebote check: mechanical switch chatter of the same key
		if (now - lastInputTimestamp) < MIN_DEBOUNCE_SAME_KEY and inputKey == lastAcceptedKey then
			return
		end

		-- 2. Step transition cooldown: ignore accidental lingering presses in the first 80ms
		if (now - stepStartTime) < MIN_STEP_TRANSITION_COOLDOWN then
			return
		end

		local isTrap = distractors[currentStep] == true
		if isTrap then
			-- Pressed a trap key! Immediate failure
			pressedTraps = true
			isRunning = false
			CleanupConnections()

			local submitRemote = Network.GetRemote("SubmitMinigameResult")
			submitRemote:FireServer(1, difficulty, os.clock() - startTime, token, {
				Inputs = collectedInputs,
				PressedTraps = true,
			})
			onCompleted(false, "Pulsaste una trampa distractor")
			ShowFailureModal("Pulsaste una trampa distractor")
			return
		end

		local expectedKey = sequence[currentStep]
		if inputKey == expectedKey then
			-- Success on this key!
			comboStreak += 1
			PlayDopamineChime(comboStreak)

			-- Update combo badge with animated scale punch
			comboBadge.Text = string.format("COMBO x%d! 🔥", comboStreak)
			comboBadge.TextColor3 = if comboStreak >= 4 then Color3.fromRGB(255, 80, 220) else Color3.fromRGB(255, 215, 0)
			local bTween = TweenService:Create(comboBadge, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.fromScale(0.46, 0.10)
			})
			bTween:Play()
			task.delay(0.12, function()
				if comboBadge and comboBadge.Parent then
					comboBadge.Size = UDim2.fromScale(0.4, 0.08)
				end
			end)

			lastInputTimestamp = now
			lastAcceptedKey = inputKey
			table.insert(collectedInputs, inputKey)
			currentStep += 1
			ShowStep(currentStep)
		else
			-- Wrong key pressed! Immediate failure
			isRunning = false
			CleanupConnections()

			local submitRemote = Network.GetRemote("SubmitMinigameResult")
			submitRemote:FireServer(1, difficulty, os.clock() - startTime, token, {
				Inputs = collectedInputs,
				PressedTraps = false,
			})
			local failMsg = string.format("Tecla incorrecta: se esperaba %s, pulsaste %s", expectedKey, inputKey)
			onCompleted(false, failMsg)
			ShowFailureModal(failMsg)
			return
		end
	end

	ProcessInputFunc = ProcessInput
	currentKeyProcessor = ProcessInput

	-- Connect keyboard input (we do NOT filter gameProcessed because ContextActionService sinks the movement)
	inputConn = UserInputService.InputBegan:Connect(function(input, _gameProcessed)
		if not isRunning then
			return
		end
		local keyStr: string? = nil
		if input.KeyCode == Enum.KeyCode.W then
			keyStr = "W"
		elseif input.KeyCode == Enum.KeyCode.A then
			keyStr = "A"
		elseif input.KeyCode == Enum.KeyCode.S then
			keyStr = "S"
		elseif input.KeyCode == Enum.KeyCode.D then
			keyStr = "D"
		elseif input.KeyCode == Enum.KeyCode.E then
			keyStr = "E"
		elseif input.KeyCode == Enum.KeyCode.Q then
			keyStr = "Q"
		elseif input.KeyCode == Enum.KeyCode.Space then
			keyStr = "Space"
		end

		if keyStr then
			ProcessInput(keyStr)
		end
	end)

	-- Connect touch / screen buttons
	for btnKey, btn in pairs(registeredButtons) do
		local conn = btn.Activated:Connect(function()
			-- Touch button bounce animation
			local origSize = btn.Size
			btn.Size = UDim2.fromScale(origSize.X.Scale * 0.94, origSize.Y.Scale * 0.94)
			task.delay(0.08, function()
				if btn and btn.Parent then
					btn.Size = origSize
				end
			end)
			ProcessInput(btnKey)
		end)
		table.insert(buttonConns, conn)
	end

	-- Timer update thread
	task.spawn(function()
		ShowStep(1)

		while isRunning do
			local elapsed = os.clock() - stepStartTime
			local fraction = 1 - (elapsed / qteConfig.WindowPerKey)

			if fraction <= 0 then
				local isTrap = distractors[currentStep] == true
				if isTrap then
					-- Successfully waited out the trap without pressing! Proceed!
					comboStreak += 1
					PlayDopamineChime(comboStreak)
					currentStep += 1
					ShowStep(currentStep)
				else
					-- Timeout on legitimate key!
					isRunning = false
					CleanupConnections()
					local submitRemote = Network.GetRemote("SubmitMinigameResult")
					submitRemote:FireServer(1, difficulty, os.clock() - startTime, token, {
						Inputs = collectedInputs,
						PressedTraps = false,
					})
					local timeoutMsg = "Tiempo agotado en la tecla " .. sequence[currentStep]
					onCompleted(false, timeoutMsg)
					ShowFailureModal(timeoutMsg)
					break
				end
			else
				timerFill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
			end

			task.wait(0.03)
		end

		CleanupConnections()
	end)
end

function M1_ReflexQTE.Init()
	Network.InitializeRemotes()
	local startRemote = Network.GetRemote("StartMinigameClient")
	startRemote.OnClientEvent:Connect(function(machineId: any, difficulty: any, _duration: any, token: any, payload: any)
		if machineId == 1 and typeof(token) == "string" and typeof(payload) == "table" then
			local seq = payload.Sequence or { "W", "A", "S", "D" }
			local distractors = payload.Distractors or {}
			M1_ReflexQTE.StartMinigame(difficulty or 1, token, seq, distractors, function(win, reason)
				print(string.format("QTE Minigame result: %s (Reason: %s)", tostring(win), tostring(reason)))
			end)
		end
	end)
end

return M1_ReflexQTE
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">M2_LaserGrid</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Network = require(ReplicatedStorage.Shared.Network)
local MinigameLevelsData = require(ReplicatedStorage.Shared.Config.MinigameLevelsData)

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui

local M2_LaserGrid = {}

local isRunning = false
local activeConnection: RBXScriptConnection? = nil
local activeHud: ScreenGui? = nil

local function ShowAutoAdvanceBanner(zoneUnlocked: number)
	local toastGui = Instance.new("ScreenGui")
	toastGui.Name = "AutoAdvanceToast_M2"
	toastGui.ResetOnSpawn = false
	toastGui.Parent = playerGui

	local banner = Instance.new("Frame")
	banner.Name = "ToastBanner"
	banner.Size = UDim2.fromScale(0.56, 0.08)
	banner.Position = UDim2.fromScale(0.22, 0.04)
	banner.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
	banner.BorderSizePixel = 0
	banner.Parent = toastGui

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 10)
	bCorner.Parent = banner

	local bStroke = Instance.new("UIStroke")
	bStroke.Color = Color3.fromRGB(50, 255, 120)
	bStroke.Thickness = 2.5
	bStroke.Parent = banner

	local bText = Instance.new("TextLabel")
	bText.Size = UDim2.fromScale(1, 1)
	bText.BackgroundTransparency = 1
	bText.Text = string.format("🏆 ¡SALA 2 SUPERADA! >> AVANZANDO A SALA %d (+25 CRÉDITOS)", zoneUnlocked)
	bText.TextColor3 = Color3.fromRGB(255, 215, 0)
	bText.TextScaled = true
	bText.Font = Enum.Font.GothamBlack
	bText.Parent = banner

	task.delay(2.5, function()
		if toastGui and toastGui.Parent then
			local tw = TweenService:Create(banner, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
			tw:Play()
			task.wait(0.4)
			toastGui:Destroy()
		end
	end)
end

function M2_LaserGrid.StartMinigame(
	difficulty: number,
	token: string,
	maxDuration: number?,
	onCompleted: (boolean, string?) -> ()
)
	if isRunning then
		return
	end
	isRunning = true

	local levelData = MinigameLevelsData.GetLevel(2, difficulty)
	local config = levelData and levelData.Specific.LaserGrid or { LaserCount = 3, LaserSpeed = 12, DisappearingPlatforms = false }
	local timeoutTotal = if typeof(maxDuration) == "number" and maxDuration > 0
		then maxDuration
		else (if levelData then levelData.MaxAllowedTime else 80.0)

	local world = Workspace:FindFirstChild("World")
	local chamber = world and world:FindFirstChild("Zones") and world.Zones:FindFirstChild("Zone_2") and world.Zones.Zone_2:FindFirstChild("MinigameChamber_2")
	if not chamber then
		isRunning = false
		onCompleted(false, "MinigameChamber_2 not found")
		return
	end

	-- Center of Chamber 2 is at Vector3.new(170, -180, 0)
	local chamberPos = Vector3.new(170, -180, 0)

	-- Teleport player onto StartPlatform at Z = -45
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp.CFrame = CFrame.new(chamberPos + Vector3.new(0, 3, -45))
	end

	-- Create HUD ScreenGui
	local hud = Instance.new("ScreenGui")
	hud.Name = "M2_LaserGrid_HUD"
	hud.ResetOnSpawn = false
	hud.Parent = playerGui
	activeHud = hud

	-- Top Instruction Banner
	local banner = Instance.new("Frame")
	banner.Name = "Banner"
	banner.Size = UDim2.fromScale(0.44, 0.07)
	banner.Position = UDim2.fromScale(0.28, 0.03)
	banner.BackgroundColor3 = Color3.fromRGB(18, 22, 34)
	banner.BorderSizePixel = 0
	banner.Parent = hud

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 8)
	bCorner.Parent = banner

	local bStroke = Instance.new("UIStroke")
	bStroke.Color = Color3.fromRGB(255, 60, 60)
	bStroke.Thickness = 2
	bStroke.Parent = banner

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundTransparency = 1
	title.Text = string.format("¡CRUZA EL CORREDOR LÁSER HASTA LA META VERDE! (Nivel %d)", difficulty)
	title.TextColor3 = Color3.fromRGB(255, 100, 100)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBold
	title.Parent = banner

	-- Visible Countdown Timer Card
	local timerCard = Instance.new("Frame")
	timerCard.Name = "TimerCard"
	timerCard.Size = UDim2.fromScale(0.32, 0.05)
	timerCard.Position = UDim2.fromScale(0.34, 0.11)
	timerCard.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	timerCard.BorderSizePixel = 0
	timerCard.Parent = hud

	local tcCorner = Instance.new("UICorner")
	tcCorner.CornerRadius = UDim.new(0, 8)
	tcCorner.Parent = timerCard

	local tcStroke = Instance.new("UIStroke")
	tcStroke.Name = "Stroke"
	tcStroke.Color = Color3.fromRGB(50, 255, 120)
	tcStroke.Thickness = 2
	tcStroke.Parent = timerCard

	local timerFill = Instance.new("Frame")
	timerFill.Name = "TimerFill"
	timerFill.Size = UDim2.fromScale(1, 1)
	timerFill.BackgroundColor3 = Color3.fromRGB(50, 255, 120)
	timerFill.BorderSizePixel = 0
	timerFill.Parent = timerCard

	local tfCorner = Instance.new("UICorner")
	tfCorner.CornerRadius = UDim.new(0, 8)
	tfCorner.Parent = timerFill

	local timerLabel = Instance.new("TextLabel")
	timerLabel.Name = "TimerLabel"
	timerLabel.Size = UDim2.fromScale(1, 1)
	timerLabel.BackgroundTransparency = 1
	timerLabel.Text = string.format("⏱️ TIEMPO: %.0fs", timeoutTotal)
	timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	timerLabel.TextScaled = true
	timerLabel.Font = Enum.Font.GothamBlack
	timerLabel.ZIndex = 2
	timerLabel.Parent = timerCard

	-- Spawn Dynamic Laser Beams (oriented along Z corridor from -34 to +34)
	local laserBeams: { { Part: Part, Z: number, Phase: number } } = {}
	local laserFolder = Instance.new("Folder")
	laserFolder.Name = "LaserBeams"
	laserFolder.Parent = chamber

	local zMin = -34
	local zMax = 34
	local zSpan = zMax - zMin
	local zStep = zSpan / (config.LaserCount + 1)

	for i = 1, config.LaserCount do
		local zPos = chamberPos.Z + zMin + (i * zStep)
		local laser = Instance.new("Part")
		laser.Name = "LaserBeam_" .. i
		laser.Size = Vector3.new(32, 0.6, 0.6)
		laser.Color = Color3.fromRGB(255, 30, 30)
		laser.Material = Enum.Material.Neon
		laser.Anchored = true
		laser.CanCollide = false
		laser.CFrame = CFrame.new(chamberPos.X, chamberPos.Y + 2.5, zPos)
		laser.Parent = laserFolder

		table.insert(laserBeams, {
			Part = laser,
			Z = zPos,
			Phase = i * 1.3,
		})
	end

	-- Goal Part at Z = +46
	local goal = Instance.new("Part")
	goal.Name = "CorridorGoal"
	goal.Size = Vector3.new(20, 8, 12)
	goal.CFrame = CFrame.new(chamberPos.X, chamberPos.Y + 4, chamberPos.Z + 46)
	goal.Color = Color3.fromRGB(50, 255, 120)
	goal.Material = Enum.Material.ForceField
	goal.Transparency = 0.5
	goal.Anchored = true
	goal.CanCollide = false
	goal.Parent = laserFolder

	local startTime = os.clock()

	local function Cleanup()
		isRunning = false
		if activeConnection then
			activeConnection:Disconnect()
			activeConnection = nil
		end
		if laserFolder then
			laserFolder:Destroy()
		end
		if activeHud then
			activeHud:Destroy()
			activeHud = nil
		end
	end

	activeConnection = RunService.Heartbeat:Connect(function()
		if not isRunning then
			return
		end

		local t = os.clock() - startTime
		local remaining = math.max(0, timeoutTotal - t)
		local frac = math.clamp(remaining / timeoutTotal, 0, 1)

		-- Update Countdown Timer Display
		timerFill.Size = UDim2.fromScale(frac, 1)
		timerLabel.Text = string.format("⏱️ TIEMPO: %.1fs", remaining)

		if frac < 0.25 then
			timerFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
			tcStroke.Color = Color3.fromRGB(255, 50, 50)
		elseif frac < 0.50 then
			timerFill.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
			tcStroke.Color = Color3.fromRGB(255, 215, 0)
		else
			timerFill.BackgroundColor3 = Color3.fromRGB(50, 255, 120)
			tcStroke.Color = Color3.fromRGB(50, 255, 120)
		end

		-- Timeout check
		if remaining <= 0 then
			Cleanup()
			local submitRemote = Network.GetRemote("SubmitMinigameResult")
			submitRemote:FireServer(2, difficulty, t, token, {
				ReachedGoal = false,
				TouchedLaser = false,
			})
			onCompleted(false, "Tiempo límite agotado en la Sala 2")
			return
		end

		-- Move lasers oscillating up and down in Y
		for _, info in ipairs(laserBeams) do
			local yOffset = 2.0 + (math.sin(t * (config.LaserSpeed * 0.22) + info.Phase) * 2.2)
			info.Part.CFrame = CFrame.new(chamberPos.X, chamberPos.Y + yOffset, info.Z)
		end

		-- Check player intersection B_p(t) cap V_laser(t)
		local currentHrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if currentHrp then
			local pPos = currentHrp.Position

			-- Pit hazard check (falling off platforms)
			if pPos.Y < (chamberPos.Y - 5) then
				Cleanup()
				local submitRemote = Network.GetRemote("SubmitMinigameResult")
				submitRemote:FireServer(2, difficulty, t, token, {
					ReachedGoal = false,
					TouchedLaser = true,
				})
				onCompleted(false, "Caíste al foso de lava")
				return
			end

			-- Laser collision check
			for _, info in ipairs(laserBeams) do
				local laserY = info.Part.Position.Y
				local deltaX = math.abs(pPos.X - chamberPos.X)
				local deltaY = math.abs(pPos.Y - laserY)
				local deltaZ = math.abs(pPos.Z - info.Z)

				if deltaX <= 16 and deltaY <= 1.6 and deltaZ <= 1.2 then
					Cleanup()
					local submitRemote = Network.GetRemote("SubmitMinigameResult")
					submitRemote:FireServer(2, difficulty, t, token, {
						ReachedGoal = false,
						TouchedLaser = true,
					})
					onCompleted(false, "Colisión con láser detectada")
					return
				end
			end

			-- Goal intersection check (reached the green goal pad at Z >= +41)
			if pPos.Z >= (chamberPos.Z + 41) and math.abs(pPos.X - chamberPos.X) <= 12 and pPos.Y >= (chamberPos.Y - 1) then
				Cleanup()
				local submitRemote = Network.GetRemote("SubmitMinigameResult")
				submitRemote:FireServer(2, difficulty, t, token, {
					ReachedGoal = true,
					TouchedLaser = false,
				})
				onCompleted(true, nil)
				ShowAutoAdvanceBanner(3)
				return
			end
		end
	end)
end

function M2_LaserGrid.Init()
	Network.InitializeRemotes()
	local startRemote = Network.GetRemote("StartMinigameClient")
	startRemote.OnClientEvent:Connect(function(machineId: any, difficulty: any, duration: any, token: any)
		if machineId == 2 and typeof(token) == "string" then
			local dur = if typeof(duration) == "number" and duration > 0 then duration else 80.0
			M2_LaserGrid.StartMinigame(difficulty or 1, token, dur, function(win, reason)
				print(string.format("LaserGrid Minigame result: %s (Reason: %s)", tostring(win), tostring(reason)))
			end)
		end
	end)
end

return M2_LaserGrid
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">M3_TargetPractice</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Network = require(ReplicatedStorage.Shared.Network)
local MinigameLevelsData = require(ReplicatedStorage.Shared.Config.MinigameLevelsData)

local localPlayer = Players.LocalPlayer

local M3_TargetPractice = {}

local isRunning = false
local activeScreenGui: ScreenGui? = nil
local activeConnections: { RBXScriptConnection } = {}

type TargetInfo = {
	Id: string,
	IsPenalty: boolean,
	Button: ImageButton,
	SpawnTime: number,
	Lifespan: number,
}

function M3_TargetPractice.StartMinigame(
	difficulty: number,
	token: string,
	onCompleted: (boolean, string?) -> ()
)
	if isRunning then
		return
	end
	isRunning = true

	local levelData = MinigameLevelsData.GetLevel(3, difficulty)
	local tpConfig = levelData and levelData.Specific.TargetPractice or {
		TargetCount = 6,
		TargetLifespan = 2.5,
		PenaltyDecoyCount = 0,
	}

	local curPlayer = localPlayer or Players.LocalPlayer
	local playerGui = curPlayer and curPlayer:FindFirstChild("PlayerGui") :: PlayerGui?
	local cam = Workspace.CurrentCamera

	-- Set Camera to first-person view inside Chamber 3 Shooting Gallery
	local originalCameraType = if cam then cam.CameraType else Enum.CameraType.Custom
	local originalCameraCFrame = if cam then cam.CFrame else CFrame.identity
	pcall(function()
		if cam then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = CFrame.new(Vector3.new(340, -174, -27), Vector3.new(340, -172, 36))
		end
	end)

	-- GUI Viewport / Shooting Gallery Container
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "M3_TargetPractice_Gui"
	screenGui.ResetOnSpawn = false
	if playerGui then
		screenGui.Parent = playerGui
	end
	activeScreenGui = screenGui

	local mainContainer = Instance.new("Frame")
	mainContainer.Name = "ArcadeBooth"
	mainContainer.Size = UDim2.fromScale(0.7, 0.75)
	mainContainer.Position = UDim2.fromScale(0.15, 0.12)
	mainContainer.BackgroundColor3 = Color3.fromRGB(12, 16, 24)
	mainContainer.BorderSizePixel = 0
	mainContainer.Parent = screenGui

	local boothCorner = Instance.new("UICorner")
	boothCorner.CornerRadius = UDim.new(0, 12)
	boothCorner.Parent = mainContainer

	local boothStroke = Instance.new("UIStroke")
	boothStroke.Color = Color3.fromRGB(0, 200, 255)
	boothStroke.Thickness = 3
	boothStroke.Parent = mainContainer

	-- Header / Stats
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.fromScale(1, 0.12)
	header.BackgroundColor3 = Color3.fromRGB(18, 24, 36)
	header.BorderSizePixel = 0
	header.Parent = mainContainer

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(0.45, 1)
	titleLabel.Position = UDim2.fromScale(0.03, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = string.format("GALERÍA DE TIRO (Nivel %d)", difficulty)
	titleLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
	titleLabel.TextScaled = true
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Parent = header

	local scoreLabel = Instance.new("TextLabel")
	scoreLabel.Name = "ScoreLabel"
	scoreLabel.Size = UDim2.fromScale(0.45, 1)
	scoreLabel.Position = UDim2.fromScale(0.52, 0)
	scoreLabel.BackgroundTransparency = 1
	scoreLabel.Text = string.format("Dianas: 0 / %d", tpConfig.TargetCount)
	scoreLabel.TextColor3 = Color3.fromRGB(255, 220, 0)
	scoreLabel.TextScaled = true
	scoreLabel.Font = Enum.Font.GothamBold
	scoreLabel.Parent = header

	-- Gallery Viewport Area
	local galleryFrame = Instance.new("Frame")
	galleryFrame.Name = "GalleryArea"
	galleryFrame.Size = UDim2.fromScale(0.94, 0.82)
	galleryFrame.Position = UDim2.fromScale(0.03, 0.15)
	galleryFrame.BackgroundColor3 = Color3.fromRGB(22, 28, 42)
	galleryFrame.ClipsDescendants = true
	galleryFrame.BorderSizePixel = 0
	galleryFrame.Parent = mainContainer

	local galleryCorner = Instance.new("UICorner")
	galleryCorner.CornerRadius = UDim.new(0, 8)
	galleryCorner.Parent = galleryFrame

	-- Custom Reticle
	local reticle = Instance.new("ImageLabel")
	reticle.Name = "Crosshair"
	reticle.Size = UDim2.fromOffset(36, 36)
	reticle.AnchorPoint = Vector2.new(0.5, 0.5)
	reticle.BackgroundTransparency = 1
	reticle.Image = "rbxassetid://6031075931" -- Standard target reticle or circular asset
	reticle.ImageColor3 = Color3.fromRGB(0, 255, 200)
	reticle.Visible = false
	reticle.Parent = galleryFrame

	-- Game Variables and Set Relations
	-- T_active = { t_1, ..., t_m }, T_penalty = { p_1, ..., p_k }
	local activeTargets: { [string]: TargetInfo } = {}
	local penaltyTargets: { [string]: TargetInfo } = {}
	local targetCounter = 0
	local targetsHit = 0
	local penaltyHits = 0
	local startTime = os.clock()

	local function Cleanup()
		isRunning = false
		for _, conn in ipairs(activeConnections) do
			conn:Disconnect()
		end
		table.clear(activeConnections)

		pcall(function()
			if cam then
				cam.CameraType = originalCameraType
				cam.CFrame = originalCameraCFrame
			end
		end)

		if activeScreenGui then
			activeScreenGui:Destroy()
			activeScreenGui = nil
		end
	end

	local function PlayHitSound(isSuccess: boolean)
		local sound = Instance.new("Sound")
		sound.SoundId = if isSuccess then "rbxasset://sounds/electronicpingshort.wav" else "rbxasset://sounds/bass.wav"
		sound.Volume = 0.6
		sound.Parent = Workspace
		sound:Play()
		task.delay(1, function()
			sound:Destroy()
		end)
	end

	local function RemoveTarget(targetId: string, fromPenalty: boolean)
		-- Discrete Set Difference: T_active' = T_active \ { t_i }
		local target = if fromPenalty then penaltyTargets[targetId] else activeTargets[targetId]
		if target then
			if fromPenalty then
				penaltyTargets[targetId] = nil
			else
				activeTargets[targetId] = nil
			end
			target.Button:Destroy()
		end
	end

	local function SpawnTarget(isPenalty: boolean)
		if not isRunning then
			return
		end
		targetCounter += 1
		local targetId = "target_" .. tostring(targetCounter)

		local targetBtn = Instance.new("ImageButton")
		targetBtn.Name = targetId
		targetBtn.Size = UDim2.fromScale(0.12, 0.16)
		local posX = math.random(5, 80) / 100
		local posY = math.random(5, 75) / 100
		targetBtn.Position = UDim2.fromScale(posX, posY)
		targetBtn.BackgroundColor3 = if isPenalty then Color3.fromRGB(220, 30, 30) else Color3.fromRGB(0, 180, 255)
		targetBtn.BorderSizePixel = 0
		targetBtn.AutoButtonColor = false

		local tCorner = Instance.new("UICorner")
		tCorner.CornerRadius = UDim.new(1, 0) -- Circular target
		tCorner.Parent = targetBtn

		local tStroke = Instance.new("UIStroke")
		tStroke.Color = if isPenalty then Color3.fromRGB(255, 100, 100) else Color3.fromRGB(255, 255, 255)
		tStroke.Thickness = 2
		tStroke.Parent = targetBtn

		local centerDot = Instance.new("Frame")
		centerDot.Name = "Bullseye"
		centerDot.Size = UDim2.fromScale(0.35, 0.35)
		centerDot.AnchorPoint = Vector2.new(0.5, 0.5)
		centerDot.Position = UDim2.fromScale(0.5, 0.5)
		centerDot.BackgroundColor3 = if isPenalty then Color3.fromRGB(0, 0, 0) else Color3.fromRGB(255, 40, 40)
		centerDot.BorderSizePixel = 0
		centerDot.Parent = targetBtn

		local dotCorner = Instance.new("UICorner")
		dotCorner.CornerRadius = UDim.new(1, 0)
		dotCorner.Parent = centerDot

		targetBtn.Parent = galleryFrame

		local info: TargetInfo = {
			Id = targetId,
			IsPenalty = isPenalty,
			Button = targetBtn,
			SpawnTime = os.clock(),
			Lifespan = tpConfig.TargetLifespan,
		}

		if isPenalty then
			penaltyTargets[targetId] = info
		else
			activeTargets[targetId] = info
		end

		-- Target click handler (Directed Ray / Hit projection, compatible with PC and Mobile)
		targetBtn.Activated:Connect(function()
			if not isRunning then
				return
			end

			if isPenalty then
				penaltyHits += 1
				PlayHitSound(false)
				RemoveTarget(targetId, true)

				-- In high difficulties (d >= 4), hitting penalty decoy terminates attempt
				if difficulty >= 4 then
					Cleanup()
					local submitRemote = Network.GetRemote("SubmitMinigameResult")
					submitRemote:FireServer(3, difficulty, os.clock() - startTime, token, {
						TargetsHit = targetsHit,
						PenaltyHits = penaltyHits,
					})
					onCompleted(false, "Penalización activada: Impactaste una diana trampa")
					return
				end
			else
				targetsHit += 1
				scoreLabel.Text = string.format("Dianas: %d / %d", targetsHit, tpConfig.TargetCount)
				PlayHitSound(true)
				RemoveTarget(targetId, false)

				-- Check victory condition
				if targetsHit >= tpConfig.TargetCount then
					Cleanup()
					local totalDuration = os.clock() - startTime
					local submitRemote = Network.GetRemote("SubmitMinigameResult")
					submitRemote:FireServer(3, difficulty, totalDuration, token, {
						TargetsHit = targetsHit,
						PenaltyHits = penaltyHits,
					})
					onCompleted(true, nil)

					-- Auto-advance toast banner
					local toastGui = Instance.new("ScreenGui")
					toastGui.Name = "AutoAdvanceToast_M3"
					toastGui.ResetOnSpawn = false
					if playerGui then
						toastGui.Parent = playerGui
					end

					local banner = Instance.new("Frame")
					banner.Name = "ToastBanner"
					banner.Size = UDim2.fromScale(0.56, 0.08)
					banner.Position = UDim2.fromScale(0.22, 0.04)
					banner.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
					banner.BorderSizePixel = 0
					banner.Parent = toastGui

					local bCorner = Instance.new("UICorner")
					bCorner.CornerRadius = UDim.new(0, 10)
					bCorner.Parent = banner

					local bStroke = Instance.new("UIStroke")
					bStroke.Color = Color3.fromRGB(0, 220, 255)
					bStroke.Thickness = 2.5
					bStroke.Parent = banner

					local bText = Instance.new("TextLabel")
					bText.Size = UDim2.fromScale(1, 1)
					bText.BackgroundTransparency = 1
					bText.Text = "🏆 ¡SALA 3 SUPERADA! >> AVANZANDO A SALA 4 (+25 CRÉDITOS)"
					bText.TextColor3 = Color3.fromRGB(255, 215, 0)
					bText.TextScaled = true
					bText.Font = Enum.Font.GothamBlack
					bText.Parent = banner

					task.delay(2.5, function()
						if toastGui and toastGui.Parent then
							local tw = TweenService:Create(banner, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
							tw:Play()
							task.wait(0.4)
							toastGui:Destroy()
						end
					end)
					return
				end
			end
		end)

		-- Animated shrink during lifespan
		local shrinkTween = TweenService:Create(
			targetBtn,
			TweenInfo.new(tpConfig.TargetLifespan, Enum.EasingStyle.Linear),
			{ Size = UDim2.fromScale(0.02, 0.03) }
		)
		shrinkTween:Play()
	end

	-- Update reticle cursor position on mouse / touch movement
	local moveConn = UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			local mousePos: Vector3 = input.Position
			local framePos: Vector2 = galleryFrame.AbsolutePosition
			reticle.Visible = true
			reticle.Position = UDim2.fromOffset(mousePos.X - framePos.X, mousePos.Y - framePos.Y)
		end
	end)
	table.insert(activeConnections, moveConn)

	-- Spawner and Lifespan lifecycle loop
	task.spawn(function()
		local spawnInterval = math.clamp(tpConfig.TargetLifespan * 0.7, 0.4, 2.0)
		local nextSpawn = os.clock()

		while isRunning do
			local now = os.clock()

			-- Expire old targets: T_active' = T_active \ { t | now - t.SpawnTime >= t.Lifespan }
			for id, target in pairs(activeTargets) do
				if (now - target.SpawnTime) >= target.Lifespan then
					RemoveTarget(id, false)
				end
			end
			for id, target in pairs(penaltyTargets) do
				if (now - target.SpawnTime) >= target.Lifespan then
					RemoveTarget(id, true)
				end
			end

			-- Spawn new targets
			if now >= nextSpawn then
				nextSpawn = now + spawnInterval

				-- Determine if this should spawn a penalty decoy
				local shouldSpawnDecoy = (tpConfig.PenaltyDecoyCount > 0) and (math.random(1, 10) <= 3)
				if shouldSpawnDecoy then
					SpawnTarget(true)
				else
					SpawnTarget(false)
				end
			end

			task.wait(0.05)
		end
	end)
end

function M3_TargetPractice.Init()
	Network.InitializeRemotes()
	local startRemote = Network.GetRemote("StartMinigameClient")
	startRemote.OnClientEvent:Connect(function(machineId: any, difficulty: any, _duration: any, token: any)
		if machineId == 3 and typeof(token) == "string" then
			M3_TargetPractice.StartMinigame(difficulty or 1, token, function(win, reason)
				print(string.format("TargetPractice result: %s (Reason: %s)", tostring(win), tostring(reason)))
			end)
		end
	end)
end

return M3_TargetPractice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">M4_MemoryMatrix</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Network = require(ReplicatedStorage.Shared.Network)
local MinigameLevelsData = require(ReplicatedStorage.Shared.Config.MinigameLevelsData)

local localPlayer = Players.LocalPlayer

local M4_MemoryMatrix = {}

type GridCoord = { x: number, y: number }

local isRunning = false
local activeScreenGui: ScreenGui? = nil
local activeConnections: { RBXScriptConnection } = {}

function M4_MemoryMatrix.StartMinigame(
	difficulty: number,
	token: string,
	sequence: { GridCoord },
	flashDuration: number,
	onCompleted: (boolean, string?) -> ()
)
	if isRunning then
		return
	end
	isRunning = true

	local curPlayer = localPlayer or Players.LocalPlayer
	local playerGui = curPlayer and curPlayer:FindFirstChild("PlayerGui") :: PlayerGui?

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "M4_MemoryMatrix_Gui"
	screenGui.ResetOnSpawn = false
	if playerGui then
		screenGui.Parent = playerGui
	end
	activeScreenGui = screenGui

	-- Container
	local mainContainer = Instance.new("Frame")
	mainContainer.Name = "MatrixContainer"
	mainContainer.Size = UDim2.fromScale(0.48, 0.68)
	mainContainer.Position = UDim2.fromScale(0.26, 0.16)
	mainContainer.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	mainContainer.BorderSizePixel = 0
	mainContainer.Parent = screenGui

	local mCorner = Instance.new("UICorner")
	mCorner.CornerRadius = UDim.new(0, 14)
	mCorner.Parent = mainContainer

	local mStroke = Instance.new("UIStroke")
	mStroke.Color = Color3.fromRGB(160, 60, 255)
	mStroke.Thickness = 3
	mStroke.Parent = mainContainer

	-- Header
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.fromScale(1, 0.15)
	header.BackgroundColor3 = Color3.fromRGB(22, 26, 40)
	header.BorderSizePixel = 0
	header.Parent = mainContainer

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(1, 0.5)
	titleLabel.Position = UDim2.fromScale(0, 0.05)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = string.format("MATRIZ DE MEMORIA 4x4 (Nivel %d)", difficulty)
	titleLabel.TextColor3 = Color3.fromRGB(200, 120, 255)
	titleLabel.TextScaled = true
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Parent = header

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "Status"
	statusLabel.Size = UDim2.fromScale(1, 0.4)
	statusLabel.Position = UDim2.fromScale(0, 0.55)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = "¡MEMORIZA LA SECUENCIA!"
	statusLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	statusLabel.TextScaled = true
	statusLabel.Font = Enum.Font.GothamMedium
	statusLabel.Parent = header

	-- 4x4 Grid Frame
	local gridFrame = Instance.new("Frame")
	gridFrame.Name = "GridArea"
	gridFrame.Size = UDim2.fromScale(0.85, 0.78)
	gridFrame.Position = UDim2.fromScale(0.075, 0.18)
	gridFrame.BackgroundTransparency = 1
	gridFrame.Parent = mainContainer

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromScale(0.22, 0.22)
	gridLayout.CellPadding = UDim2.fromScale(0.04, 0.04)
	gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gridLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	gridLayout.Parent = gridFrame

	local panels: { [string]: TextButton } = {}
	local canInput = false
	local currentStep = 1
	local playerSequence: { GridCoord } = {}
	local startTime = os.clock()

	local function Cleanup()
		isRunning = false
		canInput = false
		for _, conn in ipairs(activeConnections) do
			conn:Disconnect()
		end
		table.clear(activeConnections)
		if activeScreenGui then
			activeScreenGui:Destroy()
			activeScreenGui = nil
		end
	end

	local function PlayTone(freq: number)
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
		sound.PlaybackSpeed = freq
		sound.Volume = 0.5
		sound.Parent = Workspace
		sound:Play()
		task.delay(1, function()
			sound:Destroy()
		end)
	end

	-- Instantiate the 16 Grid Tiles: G = {1..4} x {1..4}
	for y = 1, 4 do
		for x = 1, 4 do
			local key = string.format("%d_%d", x, y)
			local btn = Instance.new("TextButton")
			btn.Name = "Tile_" .. key
			btn.BackgroundColor3 = Color3.fromRGB(30, 36, 54)
			btn.Text = ""
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = false

			local bCorner = Instance.new("UICorner")
			bCorner.CornerRadius = UDim.new(0, 8)
			bCorner.Parent = btn

			local bStroke = Instance.new("UIStroke")
			bStroke.Color = Color3.fromRGB(50, 60, 90)
			bStroke.Thickness = 2
			bStroke.Parent = btn

			btn.Parent = gridFrame
			panels[key] = btn

			local clickConn = btn.MouseButton1Click:Connect(function()
				if not isRunning or not canInput then
					return
				end

				local expectedCoord = sequence[currentStep]
				if not expectedCoord then
					return
				end

				if x == expectedCoord.x and y == expectedCoord.y then
					-- Step matched: Advance
					table.insert(playerSequence, { x = x, y = y })
					PlayTone(1.0 + (currentStep * 0.1))

					btn.BackgroundColor3 = Color3.fromRGB(40, 255, 130)
					TweenService:Create(
						btn,
						TweenInfo.new(0.25),
						{ BackgroundColor3 = Color3.fromRGB(30, 36, 54) }
					):Play()

					currentStep += 1
					statusLabel.Text = string.format("Progreso: %d / %d", currentStep - 1, #sequence)

					if currentStep > #sequence then
						-- Completed full sequence!
						canInput = false
						statusLabel.Text = "¡SECUENCIA CORRECTA!"
						statusLabel.TextColor3 = Color3.fromRGB(40, 255, 130)

						task.wait(0.3)
						Cleanup()

						local totalDuration = os.clock() - startTime
						local submitRemote = Network.GetRemote("SubmitMinigameResult")
						submitRemote:FireServer(4, difficulty, totalDuration, token, {
							PlayerSequence = playerSequence,
						})

						onCompleted(true, nil)

						local toastGui = Instance.new("ScreenGui")
						toastGui.Name = "AutoAdvanceToast_M4"
						toastGui.ResetOnSpawn = false
						if playerGui then
							toastGui.Parent = playerGui
						end

						local banner = Instance.new("Frame")
						banner.Name = "ToastBanner"
						banner.Size = UDim2.fromScale(0.56, 0.08)
						banner.Position = UDim2.fromScale(0.22, 0.04)
						banner.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
						banner.BorderSizePixel = 0
						banner.Parent = toastGui

						local tbCorner = Instance.new("UICorner")
						tbCorner.CornerRadius = UDim.new(0, 10)
						tbCorner.Parent = banner

						local tbStroke = Instance.new("UIStroke")
						tbStroke.Color = Color3.fromRGB(180, 80, 255)
						tbStroke.Thickness = 2.5
						tbStroke.Parent = banner

						local bText = Instance.new("TextLabel")
						bText.Size = UDim2.fromScale(1, 1)
						bText.BackgroundTransparency = 1
						bText.Text = "🏆 ¡SALA 4 SUPERADA! >> AVANZANDO AL COLISEO FINAL (+25 CRÉDITOS)"
						bText.TextColor3 = Color3.fromRGB(255, 215, 0)
						bText.TextScaled = true
						bText.Font = Enum.Font.GothamBlack
						bText.Parent = banner

						task.delay(2.5, function()
							if toastGui and toastGui.Parent then
								local tw = TweenService:Create(banner, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
								tw:Play()
								task.wait(0.4)
								toastGui:Destroy()
							end
						end)
					end
				else
					-- Incorrect step: Failure!
					table.insert(playerSequence, { x = x, y = y })
					canInput = false
					btn.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
					PlayTone(0.5)
					statusLabel.Text = "¡PASO INCORRECTO!"
					statusLabel.TextColor3 = Color3.fromRGB(255, 40, 40)

					task.wait(0.6)
					Cleanup()

					local totalDuration = os.clock() - startTime
					local submitRemote = Network.GetRemote("SubmitMinigameResult")
					submitRemote:FireServer(4, difficulty, totalDuration, token, {
						PlayerSequence = playerSequence,
					})

					onCompleted(false, "Paso incorrecto en la secuencia")
				end
			end)
			table.insert(activeConnections, clickConn)
		end
	end

	-- Phase 1 Demonstration Playback Thread
	task.spawn(function()
		task.wait(0.8)

		for idx, coord in ipairs(sequence) do
			if not isRunning then
				return
			end

			local key = string.format("%d_%d", coord.x, coord.y)
			local btn = panels[key]
			if btn then
				statusLabel.Text = string.format("Demostración: %d / %d", idx, #sequence)
				btn.BackgroundColor3 = Color3.fromRGB(200, 100, 255)
				PlayTone(1.0 + (idx * 0.1))

				local pulse = TweenService:Create(
					btn,
					TweenInfo.new(flashDuration * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ BackgroundColor3 = Color3.fromRGB(30, 36, 54) }
				)
				pulse:Play()
			end

			task.wait(flashDuration)
		end

		if not isRunning then
			return
		end

		-- Phase 2 Start Input
		canInput = true
		statusLabel.Text = string.format("¡TU TURNO! (0 / %d)", #sequence)
		statusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
	end)
end

function M4_MemoryMatrix.Init()
	Network.InitializeRemotes()
	local startRemote = Network.GetRemote("StartMinigameClient")
	startRemote.OnClientEvent:Connect(function(machineId: any, difficulty: any, _duration: any, token: any, payload: any)
		if machineId == 4 and typeof(token) == "string" and typeof(payload) == "table" then
			local levelData = MinigameLevelsData.GetLevel(4, difficulty or 1)
			local flashDuration = if levelData and levelData.Specific.MemoryMatrix
				then levelData.Specific.MemoryMatrix.FlashDuration
				else 0.8
			local seq: { GridCoord } = payload.Sequence or {}

			M4_MemoryMatrix.StartMinigame(difficulty or 1, token, seq, flashDuration, function(win, reason)
				print(string.format("MemoryMatrix result: %s (Reason: %s)", tostring(win), tostring(reason)))
			end)
		end
	end)
end

return M4_MemoryMatrix
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">M5_BulletHell</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Network = require(ReplicatedStorage.Shared.Network)
local MinigameLevelsData = require(ReplicatedStorage.Shared.Config.MinigameLevelsData)

local localPlayer = Players.LocalPlayer

local M5_BulletHell = {}

type Projectile = {
	Part: Part,
	InitialAngle: number,
	Speed: number,
	Direction: Vector3,
	Radius: number,
	Pattern: "Linear" | "Circular" | "Cross" | "Helical" | "RadialHelical",
}

local isRunning = false
local activeConnection: RBXScriptConnection? = nil
local activeHud: ScreenGui? = nil
local activeProjectilesFolder: Folder? = nil

function M5_BulletHell.StartMinigame(
	difficulty: number,
	token: string,
	onCompleted: (boolean, string?) -> ()
)
	if isRunning then
		return
	end
	isRunning = true

	local curPlayer = localPlayer or Players.LocalPlayer
	local playerGui = curPlayer and curPlayer:FindFirstChild("PlayerGui") :: PlayerGui?
	local camera = Workspace.CurrentCamera

	local levelData = MinigameLevelsData.GetLevel(5, difficulty)
	local bhConfig = levelData and levelData.Specific.BulletHell or {
		ProjectileCount = 4,
		PatternType = "Linear" :: "Linear" | "Circular" | "Cross" | "Helical" | "RadialHelical",
		SurvivalDuration = 15,
	}

	local world = Workspace:FindFirstChild("World")
	local chamber = world and world:FindFirstChild("Zones") and world.Zones:FindFirstChild("Zone_5") and world.Zones.Zone_5:FindFirstChild("MinigameChamber_5")
	local chamberCenter = Vector3.new(480, -179, 0)
	if chamber and chamber:IsA("Model") and chamber.PrimaryPart then
		chamberCenter = chamber.PrimaryPart.Position + Vector3.new(0, 1.5, 0)
	end

	-- Teleport player into chamber
	local char = curPlayer and curPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp.CFrame = CFrame.new(chamberCenter + Vector3.new(0, 3, 0))
	end

	-- Setup top-down zenith camera
	local originalCameraType = if camera then camera.CameraType else Enum.CameraType.Custom
	local originalCameraCFrame = if camera then camera.CFrame else CFrame.identity
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.new(chamberCenter + Vector3.new(0, 42, 0), chamberCenter)
	end

	-- HUD Display
	local hud = Instance.new("ScreenGui")
	hud.Name = "M5_BulletHell_HUD"
	hud.ResetOnSpawn = false
	if playerGui then
		hud.Parent = playerGui
	end
	activeHud = hud

	local timerFrame = Instance.new("Frame")
	timerFrame.Name = "TimerCard"
	timerFrame.Size = UDim2.fromScale(0.32, 0.08)
	timerFrame.Position = UDim2.fromScale(0.34, 0.03)
	timerFrame.BackgroundColor3 = Color3.fromRGB(20, 24, 38)
	timerFrame.BorderSizePixel = 0
	timerFrame.Parent = hud

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(0, 8)
	tCorner.Parent = timerFrame

	local tStroke = Instance.new("UIStroke")
	tStroke.Color = Color3.fromRGB(255, 60, 100)
	tStroke.Thickness = 2
	tStroke.Parent = timerFrame

	local timerLabel = Instance.new("TextLabel")
	timerLabel.Name = "TimerText"
	timerLabel.Size = UDim2.fromScale(1, 1)
	timerLabel.BackgroundTransparency = 1
	timerLabel.Text = string.format("SOBREVIVE: %.1fs (Nivel %d)", bhConfig.SurvivalDuration, difficulty)
	timerLabel.TextColor3 = Color3.fromRGB(255, 80, 120)
	timerLabel.TextScaled = true
	timerLabel.Font = Enum.Font.GothamBold
	timerLabel.Parent = timerFrame

	-- Spawn Projectile Container
	local projFolder = Instance.new("Folder")
	projFolder.Name = "BulletHellProjectiles"
	projFolder.Parent = Workspace
	activeProjectilesFolder = projFolder

	local arenaRadius = 22.0
	local playerRadius = 1.6
	local projectileRadius = 1.0

	-- Instantiate Dynamic Set of Projectiles B(t) = {b_1, ..., b_k}
	local projectiles: { Projectile } = {}
	for i = 1, bhConfig.ProjectileCount do
		local angle = (i / bhConfig.ProjectileCount) * (2 * math.pi)
		local part = Instance.new("Part")
		part.Name = "Bullet_" .. i
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(projectileRadius * 2, projectileRadius * 2, projectileRadius * 2)
		part.Color = if difficulty >= 4 then Color3.fromRGB(255, 30, 200) else Color3.fromRGB(255, 60, 40)
		part.Material = Enum.Material.Neon
		part.Anchored = true
		part.CanCollide = false
		part.CastShadow = false

		local dist = 6 + (i % 3) * 5
		part.CFrame = CFrame.new(chamberCenter + Vector3.new(math.cos(angle) * dist, 1.5, math.sin(angle) * dist))
		part.Parent = projFolder

		table.insert(projectiles, {
			Part = part,
			InitialAngle = angle,
			Speed = 8 + (difficulty * 2.5),
			Direction = Vector3.new(math.cos(angle + math.pi / 2), 0, math.sin(angle + math.pi / 2)).Unit,
			Radius = projectileRadius,
			Pattern = bhConfig.PatternType,
		})
	end

	local startTime = os.clock()

	local function Cleanup()
		isRunning = false
		if activeConnection then
			activeConnection:Disconnect()
			activeConnection = nil
		end
		if camera then
			pcall(function()
				camera.CameraType = originalCameraType
				camera.CFrame = originalCameraCFrame
			end)
		end
		if activeProjectilesFolder then
			activeProjectilesFolder:Destroy()
			activeProjectilesFolder = nil
		end
		if activeHud then
			activeHud:Destroy()
			activeHud = nil
		end
	end

	activeConnection = RunService.Heartbeat:Connect(function()
		if not isRunning then
			return
		end

		local t = os.clock() - startTime
		local remainingTime = bhConfig.SurvivalDuration - t
		if remainingTime > 0 then
			timerLabel.Text = string.format("SOBREVIVE: %.1fs (Nivel %d)", remainingTime, difficulty)
		end

		local currentHrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local pPos = if currentHrp then currentHrp.Position else chamberCenter

		-- Update projectile positions along their parametric curves
		for idx, proj in ipairs(projectiles) do
			local currentPos: Vector3

			if proj.Pattern == "Linear" then
				-- Linear trajectory reflecting off arena boundary
				local cur = proj.Part.Position - chamberCenter
				local newCur = cur + (proj.Direction * (proj.Speed * 0.016))
				local dist2D = Vector2.new(newCur.X, newCur.Z).Magnitude
				if dist2D >= arenaRadius then
					-- Reflect direction vector
					local normal = Vector3.new(newCur.X, 0, newCur.Z).Unit
					proj.Direction = (proj.Direction - 2 * (proj.Direction:Dot(normal)) * normal).Unit
					newCur = normal * (arenaRadius - 0.5)
				end
				currentPos = chamberCenter + Vector3.new(newCur.X, 1.5, newCur.Z)
			elseif proj.Pattern == "Circular" then
				local curAngle = proj.InitialAngle + (t * (proj.Speed * 0.1))
				local r = 12 + math.sin(t * 2 + idx) * 6
				currentPos = chamberCenter + Vector3.new(math.cos(curAngle) * r, 1.5, math.sin(curAngle) * r)
			elseif proj.Pattern == "Cross" then
				local axis = (idx % 2 == 0) and Vector3.new(1, 0, 0) or Vector3.new(0, 0, 1)
				local offset = math.sin(t * (proj.Speed * 0.15) + idx) * (arenaRadius * 0.85)
				local perp = (idx % 2 == 0) and Vector3.new(0, 0, ((idx % 4) - 2) * 4) or Vector3.new(((idx % 4) - 2) * 4, 0, 0)
				currentPos = chamberCenter + (axis * offset) + perp + Vector3.new(0, 1.5, 0)
			elseif proj.Pattern == "Helical" then
				-- Parametric Archimedean / Logarithmic Spiral
				local omega = 2.2
				local curAngle = proj.InitialAngle + (t * omega)
				local spiralRadius = ((t * proj.Speed + (idx * 3)) % arenaRadius) + 2
				currentPos = chamberCenter + Vector3.new(math.cos(curAngle) * spiralRadius, 1.5, math.sin(curAngle) * spiralRadius)
			else -- "RadialHelical" (Difficulty 5 storm)
				local ringDir = (idx % 2 == 0) and 1 or -1
				local omega = 2.8 * ringDir
				local curAngle = proj.InitialAngle + (t * omega)
				local rWave = 4 + (((t * 12 + idx * 2.5) % (arenaRadius - 4)))
				currentPos = chamberCenter + Vector3.new(math.cos(curAngle) * rWave, 1.5, math.sin(curAngle) * rWave)
			end

			proj.Part.CFrame = CFrame.new(currentPos)

			-- Metric Collision Test: ||x_p(t) - x_b(t)|| <= r_p + r_b
			local delta = pPos - currentPos
			local distance2D = Vector2.new(delta.X, delta.Z).Magnitude
			if distance2D <= (playerRadius + proj.Radius) then
				-- Collision detected! Non-empty intersection: Fail
				Cleanup()
				local submitRemote = Network.GetRemote("SubmitMinigameResult")
				submitRemote:FireServer(5, difficulty, t, token, {
					Survived = false,
					HitDetected = true,
				})
				onCompleted(false, "Impactado por proyectil en Bullet Hell")
				return
			end
		end

		-- Check Victory Condition (survived entire T_d)
		if t >= bhConfig.SurvivalDuration then
			Cleanup()
			local submitRemote = Network.GetRemote("SubmitMinigameResult")
			submitRemote:FireServer(5, difficulty, t, token, {
				Survived = true,
				HitDetected = false,
			})
			onCompleted(true, nil)

			local toastGui = Instance.new("ScreenGui")
			toastGui.Name = "AutoAdvanceToast_M5"
			toastGui.ResetOnSpawn = false
			if playerGui then
				toastGui.Parent = playerGui
			end

			local banner = Instance.new("Frame")
			banner.Name = "ToastBanner"
			banner.Size = UDim2.fromScale(0.60, 0.08)
			banner.Position = UDim2.fromScale(0.20, 0.04)
			banner.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
			banner.BorderSizePixel = 0
			banner.Parent = toastGui

			local bCorner = Instance.new("UICorner")
			bCorner.CornerRadius = UDim.new(0, 10)
			bCorner.Parent = banner

			local bStroke = Instance.new("UIStroke")
			bStroke.Color = Color3.fromRGB(255, 215, 0)
			bStroke.Thickness = 2.5
			bStroke.Parent = banner

			local bText = Instance.new("TextLabel")
			bText.Size = UDim2.fromScale(1, 1)
			bText.BackgroundTransparency = 1
			bText.Text = "👑 ¡COLISEO COMPLETADO! ¡HAS DOMINADO TODAS LAS MÁQUINAS! 👑"
			bText.TextColor3 = Color3.fromRGB(255, 215, 0)
			bText.TextScaled = true
			bText.Font = Enum.Font.GothamBlack
			bText.Parent = banner

			task.delay(3.5, function()
				if toastGui and toastGui.Parent then
					local tw = TweenService:Create(banner, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
					tw:Play()
					task.wait(0.4)
					toastGui:Destroy()
				end
			end)
			return
		end
	end)
end

function M5_BulletHell.Init()
	Network.InitializeRemotes()
	local startRemote = Network.GetRemote("StartMinigameClient")
	startRemote.OnClientEvent:Connect(function(machineId: any, difficulty: any, _duration: any, token: any)
		if machineId == 5 and typeof(token) == "string" then
			M5_BulletHell.StartMinigame(difficulty or 1, token, function(win, reason)
				print(string.format("BulletHell result: %s (Reason: %s)", tostring(win), tostring(reason)))
			end)
		end
	end)
end

return M5_BulletHell
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">SoundManager</string>
            <string name="Source"><![CDATA[--!strict
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Network = require(ReplicatedStorage.Shared.Network)

local SoundManager = {}

local SOUND_DEFINITIONS: { [string]: { AssetId: string, Volume: number, BasePitch: number } } = {
	ButtonClick = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.4, BasePitch = 1.2 },
	ButtonHover = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.15, BasePitch = 1.8 },
	CoinPickup = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, BasePitch = 1.5 },
	HitMelee = { AssetId = "rbxasset://sounds/action_footstep_plastic.mp3", Volume = 0.7, BasePitch = 0.9 },
	HitLaser = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, BasePitch = 0.6 },
	Victory = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.9, BasePitch = 1.0 },
	Defeat = { AssetId = "rbxasset://sounds/action_footstep_plastic.mp3", Volume = 0.6, BasePitch = 0.5 },
	StreakUp = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, BasePitch = 1.4 },
	EventAlert = { AssetId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, BasePitch = 0.9 },
}

local soundFolder: Folder? = nil

local function GetSoundFolder(): Folder
	if soundFolder and soundFolder.Parent then
		return soundFolder
	end
	local existing = SoundService:FindFirstChild("CyberSoundCache")
	if existing and existing:IsA("Folder") then
		soundFolder = existing
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "CyberSoundCache"
	f.Parent = SoundService
	soundFolder = f
	return f
end

function SoundManager.PlaySound(name: string, customPitch: number?, customVolume: number?)
	local def = SOUND_DEFINITIONS[name]
	if not def then
		return
	end

	local folder = GetSoundFolder()
	local s = Instance.new("Sound")
	s.SoundId = def.AssetId
	s.Volume = customVolume or def.Volume
	s.PlaybackSpeed = (customPitch or 1.0) * def.BasePitch
	s.RollOffMaxDistance = 100
	s.Parent = folder

	s.Ended:Connect(function()
		s:Destroy()
	end)

	s:Play()
end

function SoundManager.PlayButtonClick()
	SoundManager.PlaySound("ButtonClick", 1.0)
end

function SoundManager.PlayButtonHover()
	SoundManager.PlaySound("ButtonHover", 1.0)
end

function SoundManager.PlayCoin()
	SoundManager.PlaySound("CoinPickup", 1.0 + (math.random() * 0.2))
end

function SoundManager.PlayHit()
	SoundManager.PlaySound("HitMelee", 0.9 + (math.random() * 0.2))
end

function SoundManager.PlayWin()
	SoundManager.PlaySound("Victory", 1.2)
end

function SoundManager.PlayDefeat()
	SoundManager.PlaySound("Defeat", 0.8)
end

function SoundManager.PlayComboChime(comboIndex: number)
	-- Ascending melodic pitch for combos
	local pitchMultiplier = 1.0 + math.clamp(comboIndex * 0.08, 0, 0.8)
	SoundManager.PlaySound("StreakUp", pitchMultiplier)
end

function SoundManager.PlayEventAlert()
	SoundManager.PlaySound("EventAlert", 1.0)
end

function SoundManager.Init()
	-- Listen for server-requested sound triggers
	local playSoundRemote = Network.GetRemote("PlayClientSound")
	playSoundRemote.OnClientEvent:Connect(function(soundName: any, pitch: any)
		if typeof(soundName) == "string" then
			SoundManager.PlaySound(soundName, if typeof(pitch) == "number" then pitch else nil)
		end
	end)
end

return SoundManager
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="56">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">AssetIcons</string>
              <string name="Source"><![CDATA[--!strict
export type WeaponIconInfo = {
	Glyph: string,
	Color: Color3,
	AccentColor: Color3,
	Tier: number,
	Name: string,
}

local WEAPON_ICON_DATA: { [string]: WeaponIconInfo } = {
	w_0 = { Glyph = "👊", Color = Color3.fromRGB(120, 120, 130), AccentColor = Color3.fromRGB(180, 180, 190), Tier = 1, Name = "Puños" },
	w_1 = { Glyph = "🏏", Color = Color3.fromRGB(160, 110, 60), AccentColor = Color3.fromRGB(220, 160, 90), Tier = 1, Name = "Bate de Madera" },
	w_2a = { Glyph = "🗡️", Color = Color3.fromRGB(70, 130, 180), AccentColor = Color3.fromRGB(120, 190, 240), Tier = 2, Name = "Cuchillo Táctico" },
	w_2b = { Glyph = "🎯", Color = Color3.fromRGB(60, 150, 90), AccentColor = Color3.fromRGB(100, 220, 140), Tier = 2, Name = "Resortera" },
	w_3a = { Glyph = "⚔️", Color = Color3.fromRGB(65, 105, 225), AccentColor = Color3.fromRGB(130, 170, 255), Tier = 3, Name = "Espada Corta" },
	w_3b = { Glyph = "🔫", Color = Color3.fromRGB(90, 100, 140), AccentColor = Color3.fromRGB(160, 175, 220), Tier = 3, Name = "Pistola Básica" },
	w_4a = { Glyph = "⚡", Color = Color3.fromRGB(160, 60, 230), AccentColor = Color3.fromRGB(215, 120, 255), Tier = 4, Name = "Katana" },
	w_4b = { Glyph = "💥", Color = Color3.fromRGB(230, 80, 40), AccentColor = Color3.fromRGB(255, 150, 80), Tier = 4, Name = "Escopeta" },
	w_5a = { Glyph = "🔨", Color = Color3.fromRGB(230, 170, 20), AccentColor = Color3.fromRGB(255, 220, 80), Tier = 5, Name = "Martillo Pesado" },
	w_5b = { Glyph = "⚛️", Color = Color3.fromRGB(0, 210, 255), AccentColor = Color3.fromRGB(140, 245, 255), Tier = 5, Name = "Rifle de Plasma" },
}

local DIFFICULTY_COLORS: { [number]: { Color: Color3, Accent: Color3, Title: string } } = {
	[1] = { Color = Color3.fromRGB(46, 204, 113), Accent = Color3.fromRGB(100, 255, 160), Title = "Novato" },
	[2] = { Color = Color3.fromRGB(52, 152, 219), Accent = Color3.fromRGB(120, 200, 255), Title = "Intermedio" },
	[3] = { Color = Color3.fromRGB(155, 89, 182), Accent = Color3.fromRGB(210, 140, 255), Title = "Avanzado" },
	[4] = { Color = Color3.fromRGB(230, 126, 34), Accent = Color3.fromRGB(255, 170, 90), Title = "Experto" },
	[5] = { Color = Color3.fromRGB(241, 196, 15), Accent = Color3.fromRGB(255, 235, 100), Title = "Cumbre" },
}

local AssetIcons = {}

function AssetIcons.GetWeaponData(weaponId: string): WeaponIconInfo
	return WEAPON_ICON_DATA[weaponId] or {
		Glyph = "⚔️",
		Color = Color3.fromRGB(100, 100, 100),
		AccentColor = Color3.fromRGB(180, 180, 180),
		Tier = 1,
		Name = weaponId,
	}
end

function AssetIcons.CreateWeaponIcon(weaponId: string, parent: Instance?): Frame
	local data = AssetIcons.GetWeaponData(weaponId)

	local card = Instance.new("Frame")
	card.Name = "WeaponIcon_" .. weaponId
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
	card.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = data.Color
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 32, 40)),
		ColorSequenceKeypoint.new(1, data.Color),
	})
	gradient.Rotation = 45
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 0.7),
	})
	gradient.Parent = card

	local glyphLabel = Instance.new("TextLabel")
	glyphLabel.Name = "Glyph"
	glyphLabel.Size = UDim2.fromScale(1, 0.6)
	glyphLabel.Position = UDim2.fromScale(0, 0.05)
	glyphLabel.BackgroundTransparency = 1
	glyphLabel.Text = data.Glyph
	glyphLabel.TextScaled = true
	glyphLabel.Font = Enum.Font.GothamBold
	glyphLabel.Parent = card

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.fromScale(1, 0.3)
	nameLabel.Position = UDim2.fromScale(0, 0.65)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = data.Name
	nameLabel.TextColor3 = data.AccentColor
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.Parent = card

	local tierBadge = Instance.new("TextLabel")
	tierBadge.Name = "TierBadge"
	tierBadge.Size = UDim2.fromScale(0.3, 0.2)
	tierBadge.Position = UDim2.fromScale(0.05, 0.05)
	tierBadge.BackgroundColor3 = data.Color
	tierBadge.TextColor3 = Color3.fromRGB(255, 255, 255)
	tierBadge.Text = "T" .. data.Tier
	tierBadge.TextScaled = true
	tierBadge.Font = Enum.Font.GothamBold
	tierBadge.BorderSizePixel = 0
	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(0, 4)
	badgeCorner.Parent = tierBadge
	tierBadge.Parent = card

	if parent then
		card.Parent = parent
	end

	return card
end

function AssetIcons.CreateDifficultyBadge(difficulty: number, parent: Instance?): Frame
	local clamped = math.clamp(difficulty, 1, 5)
	local info = DIFFICULTY_COLORS[clamped]

	local badge = Instance.new("Frame")
	badge.Name = "DiffBadge_" .. clamped
	badge.Size = UDim2.fromScale(1, 1)
	badge.BackgroundColor3 = Color3.fromRGB(15, 18, 25)
	badge.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = badge

	local stroke = Instance.new("UIStroke")
	stroke.Color = info.Color
	stroke.Thickness = 2
	stroke.Parent = badge

	local stars = string.rep("★", clamped) .. string.rep("☆", 5 - clamped)

	local starLabel = Instance.new("TextLabel")
	starLabel.Name = "Stars"
	starLabel.Size = UDim2.fromScale(1, 0.5)
	starLabel.Position = UDim2.fromScale(0, 0.05)
	starLabel.BackgroundTransparency = 1
	starLabel.Text = stars
	starLabel.TextColor3 = info.Accent
	starLabel.TextScaled = true
	starLabel.Font = Enum.Font.GothamBold
	starLabel.Parent = badge

	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "Title"
	textLabel.Size = UDim2.fromScale(1, 0.4)
	textLabel.Position = UDim2.fromScale(0, 0.55)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = string.format("Nivel %d: %s", clamped, info.Title)
	textLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamMedium
	textLabel.Parent = badge

	if parent then
		badge.Parent = parent
	end

	return badge
end

return AssetIcons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">MachineHUD</string>
              <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")

local MachineHUD = {}

local modalFrame: Frame? = nil
local timerLabel: TextLabel? = nil
local timerThread: thread? = nil
local currentOnSelect: ((number) -> ())? = nil

local isSelectorOpen = false

local DIFFICULTY_NAMES = {
	[1] = "Novato",
	[2] = "Intermedio",
	[3] = "Avanzado",
	[4] = "Experto",
	[5] = "Cumbre",
}

local DIFFICULTY_COLORS = {
	[1] = Color3.fromRGB(46, 204, 113),
	[2] = Color3.fromRGB(52, 152, 219),
	[3] = Color3.fromRGB(155, 89, 182),
	[4] = Color3.fromRGB(230, 126, 34),
	[5] = Color3.fromRGB(241, 196, 15),
}

function MachineHUD.Init(parentGui: ScreenGui)
	local modal = Instance.new("Frame")
	modal.Name = "DifficultySelectorModal"
	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if isMobile then
		modal.Size = UDim2.fromScale(0.86, 0.76)
		modal.Position = UDim2.fromScale(0.07, 0.12)
	else
		modal.Size = UDim2.fromScale(0.5, 0.6)
		modal.Position = UDim2.fromScale(0.25, 0.2)
	end
	modal.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.Parent = parentGui
	modalFrame = modal

	local mCorner = Instance.new("UICorner")
	mCorner.CornerRadius = UDim.new(0, 14)
	mCorner.Parent = modal

	local mStroke = Instance.new("UIStroke")
	mStroke.Color = Color3.fromRGB(0, 220, 255)
	mStroke.Thickness = 3
	mStroke.Parent = modal

	-- Title
	local title = Instance.new("TextLabel")
	title.Name = "ModalTitle"
	title.Size = UDim2.fromScale(1, 0.14)
	title.Position = UDim2.fromScale(0, 0.03)
	title.BackgroundTransparency = 1
	title.Text = "SELECCIONA LA DIFICULTAD"
	title.TextColor3 = Color3.fromRGB(0, 240, 255)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBlack
	title.Parent = modal

	-- Giant Authoritative Timeout Countdown
	local tLabel = Instance.new("TextLabel")
	tLabel.Name = "GiantTimer"
	tLabel.Size = UDim2.fromScale(1, 0.12)
	tLabel.Position = UDim2.fromScale(0, 0.16)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = "TIEMPO: 60s"
	tLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
	tLabel.TextScaled = true
	tLabel.Font = Enum.Font.GothamBold
	tLabel.Parent = modal
	timerLabel = tLabel

	-- Button Container
	local btnContainer = Instance.new("Frame")
	btnContainer.Name = "ButtonGrid"
	btnContainer.Size = UDim2.fromScale(0.9, 0.65)
	btnContainer.Position = UDim2.fromScale(0.05, 0.3)
	btnContainer.BackgroundTransparency = 1
	btnContainer.Parent = modal

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	listLayout.Parent = btnContainer
end

function MachineHUD.OpenSelector(
	_machineId: number,
	currentProgress: number,
	maxAllowedTime: number,
	onSelect: (number) -> ()
)
	if not modalFrame or isSelectorOpen then
		return
	end
	isSelectorOpen = true
	currentOnSelect = onSelect
	modalFrame.Visible = true

	local maxUnlocked = math.clamp(currentProgress + 1, 1, 5)

	-- Start Giant Countdown
	if timerThread and timerThread ~= coroutine.running() then
		task.cancel(timerThread)
		timerThread = nil
	end

	local startTime = os.clock()
	timerThread = task.spawn(function()
		while (os.clock() - startTime) < maxAllowedTime and isSelectorOpen do
			local remaining = maxAllowedTime - (os.clock() - startTime)
			if timerLabel then
				timerLabel.Text = string.format("TIEMPO: %ds", math.max(0, math.floor(remaining)))
			end
			task.wait(0.2)
		end
		if isSelectorOpen then
			MachineHUD.CloseSelector()
		end
	end)

	local btnContainer = modalFrame:FindFirstChild("ButtonGrid") :: Frame?
	if btnContainer then
		-- Clear old buttons
		for _, child in ipairs(btnContainer:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for d = 1, 5 do
			local isUnlocked = d <= maxUnlocked
			local btn = Instance.new("TextButton")
			btn.Name = "DiffBtn_" .. d
			btn.Size = UDim2.fromScale(0.95, 0.16)
			btn.LayoutOrder = d
			btn.BorderSizePixel = 0
			btn.Font = Enum.Font.GothamBold
			btn.TextScaled = true

			local bCorner = Instance.new("UICorner")
			bCorner.CornerRadius = UDim.new(0, 8)
			bCorner.Parent = btn

			local diffColor = DIFFICULTY_COLORS[d] or Color3.fromRGB(150, 150, 150)

			if isUnlocked then
				btn.BackgroundColor3 = Color3.fromRGB(25, 30, 45)
				btn.TextColor3 = diffColor
				btn.Text = string.format("Nivel %d: %s [DESBLOQUEADO]", d, DIFFICULTY_NAMES[d])

				local bStroke = Instance.new("UIStroke")
				bStroke.Color = diffColor
				bStroke.Thickness = 1.5
				bStroke.Parent = btn

				btn.Activated:Connect(function()
					MachineHUD.SelectDifficulty(d)
				end)
			else
				btn.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
				btn.TextColor3 = Color3.fromRGB(90, 95, 110)
				btn.Text = string.format("🔒 Nivel %d: %s (Supera Nivel %d)", d, DIFFICULTY_NAMES[d], d - 1)
				btn.AutoButtonColor = false
			end

			btn.Parent = btnContainer
		end
	end
end

function MachineHUD.SelectDifficulty(difficulty: number)
	if currentOnSelect then
		local cb = currentOnSelect
		MachineHUD.CloseSelector()
		cb(difficulty)
	end
end

function MachineHUD.CloseSelector()
	isSelectorOpen = false
	currentOnSelect = nil
	if timerThread and timerThread ~= coroutine.running() then
		task.cancel(timerThread)
		timerThread = nil
	end
	if modalFrame then
		modalFrame.Visible = false
	end
end

function MachineHUD.IsOpen(): boolean
	return isSelectorOpen
end

return MachineHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">NavigationBeacon</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ZonesConfig = require(ReplicatedStorage.Shared.Config.ZonesConfig)

local localPlayer = Players.LocalPlayer
local NavigationBeacon = {}

local currentZone = 1
local currentProgress = 0
local beaconGui: BillboardGui? = nil
local beaconPart: Part? = nil
local beaconText: TextLabel? = nil
local distanceText: TextLabel? = nil
local renderConn: RBXScriptConnection? = nil

function NavigationBeacon.Init(parentGui: ScreenGui)
	local part = Instance.new("Part")
	part.Name = "NavigationTargetAnchor"
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.Parent = Workspace
	beaconPart = part

	local bb = Instance.new("BillboardGui")
	bb.Name = "ObjectiveBeacon"
	bb.Adornee = part
	bb.Size = UDim2.fromScale(5, 2.2)
	bb.StudsOffset = Vector3.new(0, 7, 0)
	bb.AlwaysOnTop = true
	bb.Parent = parentGui
	beaconGui = bb

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
	frame.BackgroundTransparency = 0.25
	frame.BorderSizePixel = 0
	frame.Parent = bb

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 240, 255)
	stroke.Thickness = 2
	stroke.Parent = frame

	local icon = Instance.new("TextLabel")
	icon.Name = "ArrowIcon"
	icon.Size = UDim2.fromScale(1, 0.35)
	icon.Position = UDim2.fromScale(0, 0.05)
	icon.BackgroundTransparency = 1
	icon.Text = "▼ OBJETIVO PRINCIPAL ▼"
	icon.TextColor3 = Color3.fromRGB(0, 255, 180)
	icon.TextScaled = true
	icon.Font = Enum.Font.GothamBlack
	icon.Parent = frame

	local title = Instance.new("TextLabel")
	title.Name = "ObjectiveTitle"
	title.Size = UDim2.fromScale(0.95, 0.35)
	title.Position = UDim2.fromScale(0.025, 0.38)
	title.BackgroundTransparency = 1
	title.Text = "Captura la Máquina 1"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBold
	title.Parent = frame
	beaconText = title

	local distLabel = Instance.new("TextLabel")
	distLabel.Name = "DistanceLabel"
	distLabel.Size = UDim2.fromScale(1, 0.25)
	distLabel.Position = UDim2.fromScale(0, 0.72)
	distLabel.BackgroundTransparency = 1
	distLabel.Text = "Distancia: 0m"
	distLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	distLabel.TextScaled = true
	distLabel.Font = Enum.Font.GothamMedium
	distLabel.Parent = frame
	distanceText = distLabel

	NavigationBeacon.UpdateTarget()

	renderConn = RunService.RenderStepped:Connect(function()
		local char = localPlayer.Character
		if not char or not beaconPart then
			return
		end
		local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hrp then
			return
		end

		local dist = (hrp.Position - beaconPart.Position).Magnitude
		if distanceText then
			distanceText.Text = string.format("Distancia: %d studs", math.floor(dist))
		end
	end)
end

function NavigationBeacon.UpdateProgress(zone: number, progress: number)
	currentZone = zone
	currentProgress = progress
	NavigationBeacon.UpdateTarget()
end

function NavigationBeacon.UpdateTarget()
	if not beaconPart or not beaconText then
		return
	end

	local zoneDef = ZonesConfig.GetByIndex(currentZone)
	if not zoneDef then
		return
	end

	if currentProgress >= 5 and currentZone < 5 then
		-- Target is the Gate to next zone
		local corridorGateX = zoneDef.Center.X + zoneDef.Size.X / 2 + 20
		beaconPart.CFrame = CFrame.new(corridorGateX, 5, 0)
		beaconText.Text = string.format("¡CRUZA A LA ZONA %d!", currentZone + 1)
	else
		-- Target is the Machine Capture Pad
		beaconPart.CFrame = CFrame.new(zoneDef.PadPosition + Vector3.new(0, 2, 0))
		beaconText.Text = string.format("MÁQUINA %d (Nivel %d/5)", currentZone, currentProgress)
	end
end

function NavigationBeacon.Destroy()
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	if beaconGui then
		beaconGui:Destroy()
		beaconGui = nil
	end
	if beaconPart then
		beaconPart:Destroy()
		beaconPart = nil
	end
end

return NavigationBeacon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">ProgressTracker</string>
              <string name="Source"><![CDATA[--!strict
local ProgressTracker = {}

local zoneLabel: TextLabel? = nil
local stateBadge: TextLabel? = nil
local starsLabel: TextLabel? = nil
local captureBarFrame: Frame? = nil
local captureFill: Frame? = nil

local immunityCountdownThread: thread? = nil

local STATE_COLORS: { [string]: Color3 } = {
	Combat = Color3.fromRGB(255, 100, 40),
	Capturing = Color3.fromRGB(255, 200, 20),
	Playing = Color3.fromRGB(0, 220, 255),
	Immunity = Color3.fromRGB(120, 255, 180),
	Dead = Color3.fromRGB(180, 40, 40),
}

function ProgressTracker.Init(parentGui: ScreenGui)
	-- Top HUD Banner
	local topBar = Instance.new("Frame")
	topBar.Name = "TopHUD"
	topBar.Size = UDim2.fromScale(0.6, 0.07)
	topBar.Position = UDim2.fromScale(0.2, 0.015)
	topBar.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	topBar.BorderSizePixel = 0
	topBar.Parent = parentGui

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 10)
	bCorner.Parent = topBar

	local bStroke = Instance.new("UIStroke")
	bStroke.Color = Color3.fromRGB(40, 50, 75)
	bStroke.Thickness = 2
	bStroke.Parent = topBar

	-- 1. Zone Display
	local zLabel = Instance.new("TextLabel")
	zLabel.Name = "ZoneLabel"
	zLabel.Size = UDim2.fromScale(0.3, 0.8)
	zLabel.Position = UDim2.fromScale(0.02, 0.1)
	zLabel.BackgroundTransparency = 1
	zLabel.Text = "ZONA 1: NOVATOS"
	zLabel.TextColor3 = Color3.fromRGB(180, 210, 255)
	zLabel.TextScaled = true
	zLabel.Font = Enum.Font.GothamBold
	zLabel.Parent = topBar
	zoneLabel = zLabel

	-- 2. State Badge
	local sBadge = Instance.new("TextLabel")
	sBadge.Name = "StateBadge"
	sBadge.Size = UDim2.fromScale(0.32, 0.76)
	sBadge.Position = UDim2.fromScale(0.34, 0.12)
	sBadge.BackgroundColor3 = Color3.fromRGB(25, 30, 45)
	sBadge.Text = "ESTADO: COMBATE"
	sBadge.TextColor3 = STATE_COLORS.Combat
	sBadge.TextScaled = true
	sBadge.Font = Enum.Font.GothamBlack
	sBadge.BorderSizePixel = 0

	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(0, 6)
	badgeCorner.Parent = sBadge

	sBadge.Parent = topBar
	stateBadge = sBadge

	-- 3. Stars / Progression Tracker
	local stLabel = Instance.new("TextLabel")
	stLabel.Name = "StarsLabel"
	stLabel.Size = UDim2.fromScale(0.32, 0.8)
	stLabel.Position = UDim2.fromScale(0.66, 0.1)
	stLabel.BackgroundTransparency = 1
	stLabel.Text = "Progreso: ☆☆☆☆☆ (0/5)"
	stLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	stLabel.TextScaled = true
	stLabel.Font = Enum.Font.GothamBold
	stLabel.Parent = topBar
	starsLabel = stLabel

	-- Screen Circular / Linear Capture Bar
	local capFrame = Instance.new("Frame")
	capFrame.Name = "CaptureOverlay"
	capFrame.Size = UDim2.fromScale(0.26, 0.05)
	capFrame.Position = UDim2.fromScale(0.37, 0.72)
	capFrame.BackgroundColor3 = Color3.fromRGB(18, 22, 34)
	capFrame.BorderSizePixel = 0
	capFrame.Visible = false
	capFrame.Parent = parentGui
	captureBarFrame = capFrame

	local capCorner = Instance.new("UICorner")
	capCorner.CornerRadius = UDim.new(0, 8)
	capCorner.Parent = capFrame

	local capStroke = Instance.new("UIStroke")
	capStroke.Color = Color3.fromRGB(255, 200, 20)
	capStroke.Thickness = 2
	capStroke.Parent = capFrame

	local capLabel = Instance.new("TextLabel")
	capLabel.Name = "CapLabel"
	capLabel.Size = UDim2.fromScale(1, 0.5)
	capLabel.Position = UDim2.fromScale(0, -0.6)
	capLabel.BackgroundTransparency = 1
	capLabel.Text = "RECLAMANDO CABINA..."
	capLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	capLabel.TextScaled = true
	capLabel.Font = Enum.Font.GothamBold
	capLabel.Parent = capFrame

	local cFill = Instance.new("Frame")
	cFill.Name = "Fill"
	cFill.Size = UDim2.fromScale(0, 1)
	cFill.BackgroundColor3 = Color3.fromRGB(255, 210, 30)
	cFill.BorderSizePixel = 0
	cFill.Parent = capFrame
	captureFill = cFill

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 6)
	fillCorner.Parent = cFill
end

function ProgressTracker.UpdateZone(zoneName: string)
	if zoneLabel then
		zoneLabel.Text = string.upper(zoneName)
	end
end

function ProgressTracker.UpdateState(newState: string)
	if not stateBadge then
		return
	end

	if immunityCountdownThread then
		task.cancel(immunityCountdownThread)
		immunityCountdownThread = nil
	end

	local color = STATE_COLORS[newState] or Color3.fromRGB(200, 200, 200)
	stateBadge.TextColor3 = color

	if newState == "Immunity" then
		stateBadge.Text = "INMUNIDAD: 10.0s"
		immunityCountdownThread = task.spawn(function()
			local startTime = os.clock()
			while (os.clock() - startTime) < 10.0 do
				local remaining = 10.0 - (os.clock() - startTime)
				if stateBadge then
					stateBadge.Text = string.format("INMUNIDAD: %.1fs", math.max(0, remaining))
				end
				task.wait(0.1)
			end
			if stateBadge then
				stateBadge.Text = "COMBATE"
				stateBadge.TextColor3 = STATE_COLORS.Combat
			end
		end)
	else
		stateBadge.Text = "ESTADO: " .. string.upper(newState)
	end
end

function ProgressTracker.UpdateProgress(machineId: number, level: number)
	if not starsLabel then
		return
	end
	local filled = math.clamp(level, 0, 5)
	local starsStr = string.rep("★", filled) .. string.rep("☆", 5 - filled)
	starsLabel.Text = string.format("M%d: %s (%d/5)", machineId, starsStr, filled)
end

function ProgressTracker.SetCaptureProgress(fraction: number)
	if not captureBarFrame or not captureFill then
		return
	end
	local clamped = math.clamp(fraction, 0, 1)
	if clamped > 0 and clamped < 1 then
		captureBarFrame.Visible = true
		captureFill.Size = UDim2.fromScale(clamped, 1)
	else
		captureBarFrame.Visible = false
		captureFill.Size = UDim2.fromScale(0, 1)
	end
end

return ProgressTracker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">ShopGUI</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShopConfig = require(ReplicatedStorage.Shared.Config.ShopConfig)
local Network = require(ReplicatedStorage.Shared.Network)
local SoundManager = require(script.Parent.Parent.SoundManager)

local ShopGUI = {}

local shopFrame: Frame? = nil
local creditsLabel: TextLabel? = nil
local currentCredits = ShopConfig.StartingCredits
local isOpen = false

function ShopGUI.Init(parentGui: ScreenGui)
	local modal = Instance.new("Frame")
	modal.Name = "CyberShopModal"
	modal.Size = UDim2.fromScale(0.68, 0.72)
	modal.Position = UDim2.fromScale(0.16, 0.14)
	modal.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.Parent = parentGui
	shopFrame = modal

	local mCorner = Instance.new("UICorner")
	mCorner.CornerRadius = UDim.new(0, 16)
	mCorner.Parent = modal

	local mStroke = Instance.new("UIStroke")
	mStroke.Color = Color3.fromRGB(255, 215, 0)
	mStroke.Thickness = 2.5
	mStroke.Parent = modal

	-- Header Bar
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.fromScale(1, 0.14)
	header.BackgroundColor3 = Color3.fromRGB(22, 28, 42)
	header.BorderSizePixel = 0
	header.Parent = modal

	local hCorner = Instance.new("UICorner")
	hCorner.CornerRadius = UDim.new(0, 16)
	hCorner.Parent = header

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(0.5, 0.8)
	title.Position = UDim2.fromScale(0.04, 0.1)
	title.BackgroundTransparency = 1
	title.Text = "🛒 CYBER-SHOP: ARMAS & INMUNIDAD"
	title.TextColor3 = Color3.fromRGB(255, 220, 60)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBlack
	title.Parent = header

	-- Credit Display
	local cLabel = Instance.new("TextLabel")
	cLabel.Name = "CreditLabel"
	cLabel.Size = UDim2.fromScale(0.3, 0.75)
	cLabel.Position = UDim2.fromScale(0.56, 0.12)
	cLabel.BackgroundColor3 = Color3.fromRGB(30, 38, 55)
	cLabel.Text = string.format("🪙 %d CRÉDITOS", currentCredits)
	cLabel.TextColor3 = Color3.fromRGB(255, 230, 80)
	cLabel.TextScaled = true
	cLabel.Font = Enum.Font.GothamBold
	cLabel.BorderSizePixel = 0
	cLabel.Parent = header
	creditsLabel = cLabel

	local cCorner = Instance.new("UICorner")
	cCorner.CornerRadius = UDim.new(0, 8)
	cCorner.Parent = cLabel

	-- Close Button
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.Size = UDim2.fromScale(0.08, 0.7)
	closeBtn.Position = UDim2.fromScale(0.89, 0.15)
	closeBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.Text = "✕"
	closeBtn.TextScaled = true
	closeBtn.Font = Enum.Font.GothamBlack
	closeBtn.BorderSizePixel = 0
	closeBtn.Parent = header

	local cbCorner = Instance.new("UICorner")
	cbCorner.CornerRadius = UDim.new(0, 8)
	cbCorner.Parent = closeBtn

	closeBtn.Activated:Connect(function()
		SoundManager.PlayButtonClick()
		ShopGUI.Close()
	end)

	-- Scrollable Items Grid
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "ItemsScroll"
	scroll.Size = UDim2.fromScale(0.92, 0.8)
	scroll.Position = UDim2.fromScale(0.04, 0.17)
	scroll.BackgroundTransparency = 1
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = Color3.fromRGB(255, 215, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromScale(0, 0)
	scroll.Parent = modal

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(260, 130)
	gridLayout.CellPadding = UDim2.fromOffset(14, 14)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = scroll

	local order = 1
	for itemId, item in pairs(ShopConfig.Items) do
		local card = Instance.new("Frame")
		card.Name = "ItemCard_" .. itemId
		card.BackgroundColor3 = Color3.fromRGB(22, 27, 40)
		card.BorderSizePixel = 0
		card.LayoutOrder = order
		order += 1
		card.Parent = scroll

		local cardCorner = Instance.new("UICorner")
		cardCorner.CornerRadius = UDim.new(0, 10)
		cardCorner.Parent = card

		local cardStroke = Instance.new("UIStroke")
		cardStroke.Color = if item.Category == "Immunity" then Color3.fromRGB(120, 255, 180) elseif item.Category == "Weapon" then Color3.fromRGB(255, 100, 50) else Color3.fromRGB(0, 200, 255)
		cardStroke.Thickness = 1.5
		cardStroke.Parent = card

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "ItemName"
		nameLabel.Size = UDim2.fromScale(0.92, 0.26)
		nameLabel.Position = UDim2.fromScale(0.04, 0.05)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = item.Name
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextScaled = true
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.Parent = card

		local descLabel = Instance.new("TextLabel")
		descLabel.Name = "ItemDesc"
		descLabel.Size = UDim2.fromScale(0.92, 0.35)
		descLabel.Position = UDim2.fromScale(0.04, 0.31)
		descLabel.BackgroundTransparency = 1
		descLabel.Text = item.Description
		descLabel.TextColor3 = Color3.fromRGB(170, 180, 205)
		descLabel.TextScaled = true
		descLabel.Font = Enum.Font.Gotham
		descLabel.Parent = card

		local buyBtn = Instance.new("TextButton")
		buyBtn.Name = "BuyBtn"
		buyBtn.Size = UDim2.fromScale(0.92, 0.28)
		buyBtn.Position = UDim2.fromScale(0.04, 0.67)
		buyBtn.BackgroundColor3 = Color3.fromRGB(35, 120, 75)
		buyBtn.TextColor3 = Color3.fromRGB(240, 255, 240)
		buyBtn.Text = string.format("COMPRAR - %d 🪙", item.Price)
		buyBtn.TextScaled = true
		buyBtn.Font = Enum.Font.GothamBlack
		buyBtn.BorderSizePixel = 0
		buyBtn.Parent = card

		local buyCorner = Instance.new("UICorner")
		buyCorner.CornerRadius = UDim.new(0, 6)
		buyCorner.Parent = buyBtn

		buyBtn.Activated:Connect(function()
			SoundManager.PlayButtonClick()
			-- Bounce tween
			local origSize = buyBtn.Size
			buyBtn.Size = UDim2.fromScale(origSize.X.Scale * 0.95, origSize.Y.Scale * 0.95)
			task.delay(0.08, function()
				if buyBtn and buyBtn.Parent then
					buyBtn.Size = origSize
				end
			end)

			local buyRemote = Network.GetRemote("RequestShopPurchase")
			buyRemote:FireServer(itemId)
		end)
	end

	-- Listen for purchase result
	local resultRemote = Network.GetRemote("ShopPurchaseResult")
	resultRemote.OnClientEvent:Connect(function(success: any, _itemId: any, newCredits: any)
		if success and typeof(newCredits) == "number" then
			SoundManager.PlayCoin()
			ShopGUI.UpdateCredits(newCredits)
		end
	end)
end

function ShopGUI.UpdateCredits(credits: number)
	currentCredits = credits
	if creditsLabel then
		creditsLabel.Text = string.format("🪙 %d CRÉDITOS", credits)
	end
end

function ShopGUI.Open()
	if shopFrame then
		isOpen = true
		shopFrame.Visible = true
		SoundManager.PlayButtonClick()
		ShopGUI.UpdateCredits(currentCredits)
	end
end

function ShopGUI.Close()
	if shopFrame then
		isOpen = false
		shopFrame.Visible = false
	end
end

function ShopGUI.Toggle()
	if isOpen then
		ShopGUI.Close()
	else
		ShopGUI.Open()
	end
end

return ShopGUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">UIManager</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Network = require(ReplicatedStorage.Shared.Network)
local AssetIcons = require(script.Parent.AssetIcons)
local ProgressTracker = require(script.Parent.ProgressTracker)
local MachineHUD = require(script.Parent.MachineHUD)
local NavigationBeacon = require(script.Parent.NavigationBeacon)
local JuiceFeedback = require(script.Parent.Parent.Combat.JuiceFeedback)
local ShopGUI = require(script.Parent.ShopGUI)
local SoundManager = require(script.Parent.Parent.SoundManager)

local localPlayer = Players.LocalPlayer

local UIManager = {}

local mainScreenGui: ScreenGui? = nil
local toastContainer: Frame? = nil
local currentHighestZone = 1

function UIManager.UpdateGateVisuals(highestUnlockedZone: number)
	currentHighestZone = math.max(currentHighestZone, highestUnlockedZone)
	local world = Workspace:FindFirstChild("World")
	if not world then
		return
	end
	local gatesFolder = world:FindFirstChild("Gates")
	if not gatesFolder then
		return
	end

	for g = 1, 4 do
		local gateModel = gatesFolder:FindFirstChild(string.format("Gate_%d_%d", g, g + 1))
		if gateModel then
			local barrier = gateModel:FindFirstChild("Barrier") :: BasePart?
			local isUnlocked = (currentHighestZone > g)

			if barrier then
				if isUnlocked then
					barrier.Transparency = 0.88
					barrier.Color = Color3.fromRGB(0, 255, 180) -- Glowing open emerald cyan
					barrier.CanCollide = false
				else
					barrier.Transparency = 0.35
					barrier.Color = Color3.fromRGB(255, 60 + g * 30, 40) -- Laser red
					barrier.CanCollide = true
				end
			end

			-- Dynamic Billboard Sign above gate
			local bb = gateModel:FindFirstChild("GateBillboard") :: BillboardGui?
			if not bb and barrier then
				local newBB = Instance.new("BillboardGui")
				newBB.Name = "GateBillboard"
				newBB.Adornee = barrier
				newBB.Size = UDim2.fromOffset(280, 65)
				newBB.StudsOffset = Vector3.new(0, 16, 0)
				newBB.AlwaysOnTop = true
				newBB.Parent = gateModel

				local signFrame = Instance.new("Frame")
				signFrame.Name = "SignFrame"
				signFrame.Size = UDim2.fromScale(1, 1)
				signFrame.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
				signFrame.BorderSizePixel = 0
				signFrame.Parent = newBB

				local sCorner = Instance.new("UICorner")
				sCorner.CornerRadius = UDim.new(0, 8)
				sCorner.Parent = signFrame

				local sStroke = Instance.new("UIStroke")
				sStroke.Name = "Stroke"
				sStroke.Thickness = 2
				sStroke.Parent = signFrame

				local signLabel = Instance.new("TextLabel")
				signLabel.Name = "SignLabel"
				signLabel.Size = UDim2.fromScale(0.9, 0.8)
				signLabel.Position = UDim2.fromScale(0.05, 0.1)
				signLabel.BackgroundTransparency = 1
				signLabel.TextScaled = true
				signLabel.Font = Enum.Font.GothamBlack
				signLabel.Parent = signFrame

				bb = newBB
			end

			if bb then
				local signFrame = bb:FindFirstChild("SignFrame")
				local signLabel = signFrame and signFrame:FindFirstChild("SignLabel") :: TextLabel?
				local signStroke = signFrame and signFrame:FindFirstChild("Stroke") :: UIStroke?
				if signLabel and signStroke then
					if isUnlocked then
						signLabel.Text = string.format("[ SALA %d: ABIERTA >> ]", g + 1)
						signLabel.TextColor3 = Color3.fromRGB(0, 255, 180)
						signStroke.Color = Color3.fromRGB(0, 255, 180)
					else
						signLabel.Text = string.format("[ BLOQUEADA: Supera Máquina %d ]", g)
						signLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
						signStroke.Color = Color3.fromRGB(255, 60, 60)
					end
				end
			end
		end
	end
end

function UIManager.Init()
	local curPlayer = localPlayer or Players.LocalPlayer
	local playerGui = curPlayer and curPlayer:WaitForChild("PlayerGui") :: PlayerGui?

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "GameHUD_Main"
	screenGui.ResetOnSpawn = false
	if playerGui then
		screenGui.Parent = playerGui
	end
	mainScreenGui = screenGui

	-- Notifications Toast Container
	local toasts = Instance.new("Frame")
	toasts.Name = "ToastContainer"
	toasts.Size = UDim2.fromScale(0.35, 0.3)
	toasts.Position = UDim2.fromScale(0.63, 0.1)
	toasts.BackgroundTransparency = 1
	toasts.Parent = screenGui
	toastContainer = toasts

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	listLayout.Parent = toasts

	-- Initialize sub-components
	ProgressTracker.Init(screenGui)
	MachineHUD.Init(screenGui)
	NavigationBeacon.Init(screenGui)
	ShopGUI.Init(screenGui)

	-- Streak Badge Display (HUD Izquierdo)
	local streakFrame = Instance.new("Frame")
	streakFrame.Name = "StreakFrame"
	streakFrame.Size = UDim2.fromScale(0.14, 0.055)
	streakFrame.Position = UDim2.fromScale(0.04, 0.02)
	streakFrame.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	streakFrame.BorderSizePixel = 0
	streakFrame.Parent = screenGui

	local sfCorner = Instance.new("UICorner")
	sfCorner.CornerRadius = UDim.new(0, 8)
	sfCorner.Parent = streakFrame

	local sfStroke = Instance.new("UIStroke")
	sfStroke.Name = "Stroke"
	sfStroke.Color = Color3.fromRGB(80, 90, 120)
	sfStroke.Thickness = 2
	sfStroke.Parent = streakFrame

	local sfLabel = Instance.new("TextLabel")
	sfLabel.Name = "StreakLabel"
	sfLabel.Size = UDim2.fromScale(0.9, 0.8)
	sfLabel.Position = UDim2.fromScale(0.05, 0.1)
	sfLabel.BackgroundTransparency = 1
	sfLabel.Text = "🔥 RACHA: x0"
	sfLabel.TextColor3 = Color3.fromRGB(160, 175, 200)
	sfLabel.TextScaled = true
	sfLabel.Font = Enum.Font.GothamBold
	sfLabel.Parent = streakFrame

	-- Dynamic Arena Event Banner (Desplegable superior)
	local eventBanner = Instance.new("Frame")
	eventBanner.Name = "ArenaEventBanner"
	eventBanner.Size = UDim2.fromScale(0.48, 0.065)
	eventBanner.Position = UDim2.fromScale(0.26, -0.09)
	eventBanner.BackgroundColor3 = Color3.fromRGB(14, 18, 30)
	eventBanner.BorderSizePixel = 0
	eventBanner.Visible = false
	eventBanner.Parent = screenGui

	local ebCorner = Instance.new("UICorner")
	ebCorner.CornerRadius = UDim.new(0, 10)
	ebCorner.Parent = eventBanner

	local ebStroke = Instance.new("UIStroke")
	ebStroke.Name = "Stroke"
	ebStroke.Color = Color3.fromRGB(255, 215, 0)
	ebStroke.Thickness = 2.5
	ebStroke.Parent = eventBanner

	local ebText = Instance.new("TextLabel")
	ebText.Name = "EventText"
	ebText.Size = UDim2.fromScale(0.94, 0.8)
	ebText.Position = UDim2.fromScale(0.03, 0.1)
	ebText.BackgroundTransparency = 1
	ebText.Text = "🚨 ¡EVENTO ACTIVO!"
	ebText.TextColor3 = Color3.fromRGB(255, 220, 50)
	ebText.TextScaled = true
	ebText.Font = Enum.Font.GothamBlack
	ebText.Parent = eventBanner

	-- Quick Access HUD Cyber-Shop Button (Ergonomic for PC and Mobile)
	local shopBtn = Instance.new("TextButton")
	shopBtn.Name = "HUD_ShopButton"
	shopBtn.Size = UDim2.fromScale(0.11, 0.055)
	shopBtn.Position = UDim2.fromScale(0.87, 0.02)
	shopBtn.BackgroundColor3 = Color3.fromRGB(24, 30, 44)
	shopBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
	shopBtn.Text = "🛒 TIENDA"
	shopBtn.TextScaled = true
	shopBtn.Font = Enum.Font.GothamBlack
	shopBtn.BorderSizePixel = 0
	shopBtn.AutoButtonColor = true
	shopBtn.Parent = screenGui

	local sbCorner = Instance.new("UICorner")
	sbCorner.CornerRadius = UDim.new(0, 8)
	sbCorner.Parent = shopBtn

	local sbStroke = Instance.new("UIStroke")
	sbStroke.Color = Color3.fromRGB(255, 215, 0)
	sbStroke.Thickness = 2
	sbStroke.Parent = shopBtn

	shopBtn.Activated:Connect(function()
		SoundManager.PlayButtonClick()
		ShopGUI.Toggle()
	end)

	-- Listen for in-world ProximityPrompts (like CyberShop_Kiosk in Zone 1)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, playerWhoTriggered)
		if playerWhoTriggered == localPlayer and prompt.Name == "OpenShopPrompt" then
			ShopGUI.Open()
		end
	end)

	-- Initial Gate Visuals update
	task.spawn(function()
		task.wait(1.0)
		UIManager.UpdateGateVisuals(1)
	end)

	if curPlayer then
		curPlayer.CharacterAdded:Connect(function()
			task.wait(0.5)
			UIManager.UpdateGateVisuals(currentHighestZone)
		end)
	end

	-- Wire Network Remotes
	Network.InitializeRemotes()

	local syncRemote = Network.GetRemote("SyncState")
	syncRemote.OnClientEvent:Connect(function(arg1: any, arg2: any)
		local payload: any = nil
		local stateStr: string? = nil

		if typeof(arg1) == "table" then
			payload = arg1
		elseif typeof(arg1) == "string" then
			stateStr = arg1
			if typeof(arg2) == "table" then
				payload = arg2
			end
		end

		if stateStr then
			ProgressTracker.UpdateState(stateStr)
		end

		if payload and typeof(payload) == "table" then
			if payload.Zone ~= nil then
				ProgressTracker.UpdateZone(tostring(payload.Zone))
			end
			if payload.State ~= nil then
				ProgressTracker.UpdateState(tostring(payload.State))
			end
			if payload.MachineId ~= nil and payload.Level ~= nil then
				ProgressTracker.UpdateProgress(payload.MachineId, payload.Level)
				NavigationBeacon.UpdateProgress(payload.MachineId, payload.Level)
			end
			if payload.HighestZone ~= nil and typeof(payload.HighestZone) == "number" then
				UIManager.UpdateGateVisuals(payload.HighestZone)
			end
			if payload.CaptureFraction ~= nil then
				ProgressTracker.SetCaptureProgress(payload.CaptureFraction)
			end
			if payload.Notification ~= nil then
				UIManager.ShowNotification("ARMERÍA", tostring(payload.Notification), Color3.fromRGB(0, 240, 255))
			end
			if payload.CreditPopup ~= nil and typeof(payload.CreditPopup) == "number" then
				JuiceFeedback.SpawnCreditPopup(nil, payload.CreditPopup, nil)
			end
			if payload.WinCelebration ~= nil then
				local celeb = payload.WinCelebration
				local title = string.format("¡VICTORIA EN MÁQUINA %d! ⭐⭐⭐", celeb.MachineId or 1)
				local msg = tostring(celeb.Message or "¡Nivel superado con éxito!")
				if celeb.RewardWeapon then
					msg ..= string.format(" [¡Arma desbloqueada: %s!]", tostring(celeb.RewardWeapon))
				end
				UIManager.ShowNotification(title, msg, Color3.fromRGB(255, 215, 0))
				local nextZone = math.clamp((celeb.MachineId or 1) + 1, 1, 5)
				UIManager.UpdateGateVisuals(nextZone)
			end
		end
	end)

	local shopResultRemote = Network.GetRemote("ShopPurchaseResult")
	shopResultRemote.OnClientEvent:Connect(function(success: any, itemId: any, _newCredits: any)
		if success then
			UIManager.ShowNotification("🛒 COMPRA COMPLETADA", string.format("¡Has adquirido con éxito: %s!", tostring(itemId)), Color3.fromRGB(50, 255, 120))
		else
			UIManager.ShowNotification("TIENDA", "No tienes suficientes créditos o nivel", Color3.fromRGB(255, 70, 70))
		end
	end)

	local forceExitRemote = Network.GetRemote("ForceExitMachine")
	forceExitRemote.OnClientEvent:Connect(function(reason: any)
		MachineHUD.CloseSelector()
		UIManager.ShowNotification("SALIDA DE MÁQUINA", tostring(reason or "Sesión finalizada"), Color3.fromRGB(255, 60, 60))
	end)

	local combatFeedback = Network.GetRemote("CombatFeedback")
	combatFeedback.OnClientEvent:Connect(function(attacker: any, targetPlayer: any, finalDamage: any, _knockback: any)
		local dmg = typeof(finalDamage) == "number" and finalDamage or 0
		local isLocalAttacker = (attacker == localPlayer)
		local isLocalTarget = (targetPlayer == localPlayer)

		local targetPos: Vector3? = nil
		if typeof(targetPlayer) == "Instance" and targetPlayer:IsA("Player") and targetPlayer.Character then
			local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				targetPos = hrp.Position
			end
		end

		if targetPos then
			JuiceFeedback.SpawnDamageNumber(targetPos, dmg, dmg >= 28)
			JuiceFeedback.CreateHitSparks(targetPos, Vector3.new(0, 1, 0))
		end

		if isLocalTarget then
			JuiceFeedback.ScreenShake(math.clamp(dmg / 6, 2, 8))
			UIManager.ShowNotification("ALERTA", string.format("Daño recibido: -%d HP", dmg), Color3.fromRGB(255, 50, 50))
		elseif isLocalAttacker then
			JuiceFeedback.ScreenShake(1.5)
			UIManager.ShowNotification("IMPACTO", string.format("Daño infligido: %d HP", dmg), Color3.fromRGB(50, 255, 120))
		end
	end)

	local streakRemote = Network.GetRemote("StreakUpdated")
	streakRemote.OnClientEvent:Connect(function(data: any)
		if typeof(data) == "table" and typeof(data.Streak) == "number" then
			local streak = data.Streak
			local mult = data.Multiplier or 1.0
			if streak > 0 then
				sfLabel.Text = string.format("🔥 RACHA: x%d (x%.2f 🪙)", streak, mult)
				sfLabel.TextColor3 = Color3.fromRGB(255, 140, 20)
				sfStroke.Color = Color3.fromRGB(255, 120, 20)

				local pulse = TweenService:Create(
					streakFrame,
					TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Size = UDim2.fromScale(0.155, 0.068) }
				)
				pulse:Play()
				task.delay(0.15, function()
					local ret = TweenService:Create(
						streakFrame,
						TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
						{ Size = UDim2.fromScale(0.14, 0.055) }
					)
					ret:Play()
				end)
			else
				sfLabel.Text = "🔥 RACHA: x0"
				sfLabel.TextColor3 = Color3.fromRGB(160, 175, 200)
				sfStroke.Color = Color3.fromRGB(80, 90, 120)
			end
		end
	end)

	local arenaEventRemote = Network.GetRemote("ArenaEventTriggered")
	arenaEventRemote.OnClientEvent:Connect(function(eventData: any)
		if typeof(eventData) == "table" then
			local title = tostring(eventData.EventName or "EVENTO DE ARENA")
			local duration = typeof(eventData.Duration) == "number" and eventData.Duration or 20
			eventBanner.Visible = true
			eventBanner.Position = UDim2.fromScale(0.26, -0.09)

			local dropTween = TweenService:Create(
				eventBanner,
				TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Position = UDim2.fromScale(0.26, 0.095) }
			)
			dropTween:Play()

			task.spawn(function()
				local start = os.clock()
				while (os.clock() - start) < duration do
					local rem = math.max(0, duration - (os.clock() - start))
					ebText.Text = string.format("%s | %ds restantes", title, math.ceil(rem))
					task.wait(0.5)
				end

				local retreatTween = TweenService:Create(
					eventBanner,
					TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Position = UDim2.fromScale(0.26, -0.09) }
				)
				retreatTween:Play()
				task.wait(0.4)
				eventBanner.Visible = false
			end)
		end
	end)
end

function UIManager.ShowNotification(title: string, message: string, accentColor: Color3?)
	if not toastContainer then
		return
	end
	local color = accentColor or Color3.fromRGB(0, 220, 255)

	local toast = Instance.new("Frame")
	toast.Name = "Toast"
	toast.Size = UDim2.fromScale(1, 0.28)
	toast.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
	toast.BorderSizePixel = 0
	toast.Parent = toastContainer

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(0, 8)
	tCorner.Parent = toast

	local tStroke = Instance.new("UIStroke")
	tStroke.Color = color
	tStroke.Thickness = 2
	tStroke.Parent = toast

	local tTitle = Instance.new("TextLabel")
	tTitle.Name = "Title"
	tTitle.Size = UDim2.fromScale(0.9, 0.45)
	tTitle.Position = UDim2.fromScale(0.05, 0.05)
	tTitle.BackgroundTransparency = 1
	tTitle.Text = title
	tTitle.TextColor3 = color
	tTitle.TextScaled = true
	tTitle.Font = Enum.Font.GothamBold
	tTitle.Parent = toast

	local tDesc = Instance.new("TextLabel")
	tDesc.Name = "Desc"
	tDesc.Size = UDim2.fromScale(0.9, 0.45)
	tDesc.Position = UDim2.fromScale(0.05, 0.5)
	tDesc.BackgroundTransparency = 1
	tDesc.Text = message
	tDesc.TextColor3 = Color3.fromRGB(220, 230, 245)
	tDesc.TextScaled = true
	tDesc.Font = Enum.Font.GothamMedium
	tDesc.Parent = toast

	-- Animated Dismiss
	task.delay(3.5, function()
		if toast and toast.Parent then
			local fade = TweenService:Create(
				toast,
				TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ BackgroundTransparency = 1 }
			)
			fade:Play()
			task.delay(0.45, function()
				toast:Destroy()
			end)
		end
	end)
end

function UIManager.ShowWeaponUnlock(weaponId: string)
	local data = AssetIcons.GetWeaponData(weaponId)
	UIManager.ShowNotification(
		"¡NUEVA ARMA DESBLOQUEADA!",
		string.format("%s %s (Tier %d)", data.Glyph, data.Name, data.Tier),
		data.Color
	)
end

function UIManager.ShowGateUnlock(gateNumber: number)
	UIManager.ShowNotification(
		"¡COMPUERTA ABIERTA!",
		string.format("Acceso a Zona %d concedido. ¡Avanza!", gateNumber + 1),
		Color3.fromRGB(50, 255, 120)
	)
end

function UIManager.GetScreenGui(): ScreenGui?
	return mainScreenGui
end

return UIManager
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WeaponController</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Types = require(ReplicatedStorage.Shared.Types)
local Network = require(ReplicatedStorage.Shared.Network)
local WeaponsConfig = require(ReplicatedStorage.Shared.Config.WeaponsConfig)

local localPlayer = Players.LocalPlayer
local WeaponController = {}

local currentEquippedTool: Tool? = nil
local lastAttackTime = 0

local function FindBestTarget(range: number): (Player?, Vector3)
	local char = localPlayer.Character
	if not char then
		return nil, Vector3.zero
	end

	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil, Vector3.zero
	end

	-- 1. Precision check: cursor raycast / hover (primary for PC mouse users)
	local mouse = localPlayer:GetMouse()
	local mouseHitPos = mouse.Hit.Position
	local targetInstance = mouse.Target
	if targetInstance then
		local model = targetInstance:FindFirstAncestorOfClass("Model")
		if model and model ~= char then
			local player = Players:GetPlayerFromCharacter(model)
			if player then
				local targetRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart?
				if targetRoot and (targetRoot.Position - root.Position).Magnitude <= range * 1.5 then
					return player, targetRoot.Position
				end
			end
		end
	end

	-- 2. Smart Aim Cone / Proximity (essential for Mobile touch and fluid melee)
	local forward = root.CFrame.LookVector
	local bestTarget: Player? = nil
	local bestDist = range * 1.35
	local bestPos = root.Position + forward * math.min(range, 6)

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= localPlayer then
			local oChar = otherPlayer.Character
			if oChar then
				local oRoot = oChar:FindFirstChild("HumanoidRootPart") :: BasePart?
				local oHum = oChar:FindFirstChildOfClass("Humanoid")
				if oRoot and oHum and oHum.Health > 0 then
					local offset = oRoot.Position - root.Position
					local dist = offset.Magnitude
					if dist <= bestDist then
						local dir = offset.Unit
						local dot = forward:Dot(dir)
						-- Forward 70-degree cone (cos(70) ~ 0.34) or direct proximity (< 5 studs)
						if dot > 0.30 or dist < 5.0 then
							bestTarget = otherPlayer
							bestDist = dist
							bestPos = oRoot.Position
						end
					end
				end
			end
		end
	end

	if bestTarget then
		return bestTarget, bestPos
	end

	return nil, mouseHitPos
end

function WeaponController.OnToolActivated(tool: Tool)
	local weaponId = tool:GetAttribute("WeaponId")
	if not weaponId or typeof(weaponId) ~= "string" then
		return
	end

	local weaponDef = WeaponsConfig.Get(weaponId :: Types.WeaponId)
	if not weaponDef then
		return
	end

	local now = os.clock()
	if (now - lastAttackTime) < weaponDef.Cooldown then
		return
	end
	lastAttackTime = now

	local targetPlayer, hitPos = FindBestTarget(weaponDef.Range)

	-- Send authoritative request to server
	local attackRemote = Network.GetRemote("RequestAttack")
	attackRemote:FireServer(targetPlayer, hitPos, weaponId)
end

local function SetupMobileAttackButton()
	if not UserInputService.TouchEnabled then
		return
	end

	local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui
	if playerGui:FindFirstChild("MobileCombatGui") then
		return
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "MobileCombatGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local attackButton = Instance.new("TextButton")
	attackButton.Name = "AttackButton"
	attackButton.Size = UDim2.fromOffset(80, 80)
	attackButton.Position = UDim2.new(1, -110, 1, -185)
	attackButton.BackgroundColor3 = Color3.fromRGB(220, 45, 45)
	attackButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	attackButton.Text = "⚔️"
	attackButton.TextScaled = true
	attackButton.Font = Enum.Font.GothamBlack
	attackButton.BorderSizePixel = 0
	attackButton.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0) -- Circular
	corner.Parent = attackButton

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 180, 50)
	stroke.Thickness = 3
	stroke.Parent = attackButton

	local labelSub = Instance.new("TextLabel")
	labelSub.Name = "SubText"
	labelSub.Size = UDim2.fromScale(1, 0.3)
	labelSub.Position = UDim2.fromScale(0, 0.7)
	labelSub.BackgroundTransparency = 1
	labelSub.Text = "ATACAR"
	labelSub.TextColor3 = Color3.fromRGB(255, 255, 200)
	labelSub.TextScaled = true
	labelSub.Font = Enum.Font.GothamBold
	labelSub.Parent = attackButton

	attackButton.Activated:Connect(function()
		-- Button bounce animation
		local anim = TweenService:Create(attackButton, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(70, 70),
			Position = UDim2.new(1, -105, 1, -180),
		})
		anim:Play()
		task.delay(0.09, function()
			local returnAnim = TweenService:Create(attackButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.fromOffset(80, 80),
				Position = UDim2.new(1, -110, 1, -185),
			})
			returnAnim:Play()
		end)

		-- Trigger attack
		if currentEquippedTool then
			WeaponController.OnToolActivated(currentEquippedTool)
		else
			-- Try auto-equipping first available tool from backpack
			local backpack = localPlayer:FindFirstChildOfClass("Backpack")
			local char = localPlayer.Character
			if backpack and char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local tool = backpack:FindFirstChildOfClass("Tool")
				if hum and tool then
					hum:EquipTool(tool)
					task.defer(function()
						WeaponController.OnToolActivated(tool)
					end)
				end
			end
		end
	end)
end

function WeaponController.Init()
	local function SetupCharacter(char: Model)
		char.ChildAdded:Connect(function(child: Instance)
			if child:IsA("Tool") then
				currentEquippedTool = child
				child.Activated:Connect(function()
					WeaponController.OnToolActivated(child)
				end)
			end
		end)

		char.ChildRemoved:Connect(function(child: Instance)
			if child == currentEquippedTool then
				currentEquippedTool = nil
			end
		end)
	end

	if localPlayer.Character then
		SetupCharacter(localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(SetupCharacter)

	-- Setup Mobile UI if on touch device
	SetupMobileAttackButton()
end

return WeaponController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>