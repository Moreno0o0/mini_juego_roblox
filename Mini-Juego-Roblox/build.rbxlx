		Prerequisites = {},
		Description = "Bate clásico contundente. Arma básica obtenible en la dispensadora de Zona 1.",
	},
	w_2a = {
		Id = "w_2a",
		Name = "Cuchillo Táctico",
		Tier = 2,
		Type = "Melee",
		BaseDamage = 18,
		Cooldown = 0.4,
		Range = 5,
		Knockback = 16,
		Prerequisites = { ["2_1"] = true },
		Description = "Arma blanca rápida y letal a corta distancia.",
	},
	w_2b = {
		Id = "w_2b",
		Name = "Resortera Reforzada",
		Tier = 2,
		Type = "Ranged",
		BaseDamage = 22,
		Cooldown = 0.9,
		Range = 45,
		Knockback = 22,
		ProjectileSpeed = 130,
		Prerequisites = { ["2_3"] = true },
		Description = "Proyectil a distancia intermedia con empuje efectivo.",
	},
	w_3a = {
		Id = "w_3a",
		Name = "Espada Corta",
		Tier = 3,
		Type = "Melee",
		BaseDamage = 30,
		Cooldown = 0.6,
		Range = 7,
		Knockback = 32,
		Prerequisites = { ["3_1"] = true },
		Description = "Corte balanceado de acero forjado para combatientes experimentados.",
	},
	w_3b = {
		Id = "w_3b",
		Name = "Pistola Básica",
		Tier = 3,
		Type = "Ranged",
		BaseDamage = 35,
		Cooldown = 0.7,
		Range = 65,
		Knockback = 26,
		ProjectileSpeed = 210,
		Prerequisites = { ["3_3"] = true },
		Description = "Disparos balísticos precisos a larga distancia.",
	},
	w_4a = {
		Id = "w_4a",
		Name = "Katana",
		Tier = 4,
		Type = "Melee",
		BaseDamage = 50,
		Cooldown = 0.5,
		Range = 8,
		Knockback = 38,
		Prerequisites = { ["4_1"] = true },
		Description = "Filo supremo capaz de eliminar adversarios con gran fluidez.",
	},
	w_4b = {
		Id = "w_4b",
		Name = "Escopeta de Combate",
		Tier = 4,
		Type = "Ranged",
		BaseDamage = 60,
		Cooldown = 1.2,
		Range = 40,
		Knockback = 58,
		ProjectileSpeed = 190,
		Pellets = 5,
		Prerequisites = { ["4_3"] = true },
		Description = "Disparo disperso devastador para desalojar cualquier plataforma.",
	},
	w_5a = {
		Id = "w_5a",
		Name = "Martillo Pesado",
		Tier = 5,
		Type = "Melee",
		BaseDamage = 75,
		Cooldown = 1.4,
		Range = 9,
		Knockback = 85,
		Prerequisites = { ["5_1"] = true },
		Description = "Masa titánica con el mayor empuje físico del juego.",
	},
	w_5b = {
		Id = "w_5b",
		Name = "Rifle de Plasma",
		Tier = 5,
		Type = "Ranged",
		BaseDamage = 90,
		Cooldown = 0.5,
		Range = 100,
		Knockback = 50,
		ProjectileSpeed = 280,
		Prerequisites = { ["5_5"] = true },
		Description = "El arma definitiva del Coliseo. Dispara proyectiles de energía pura.",
	},
}

local Module = {
	Weapons = WeaponsConfig,
}

function Module.Get(id: Types.WeaponId): WeaponDef?
	return WeaponsConfig[id]
end

function Module.GetAll(): { [string]: WeaponDef }
	return WeaponsConfig
end

function Module.GetByTier(tier: number): { WeaponDef }
	local result: { WeaponDef } = {}
	for _, def in pairs(WeaponsConfig) do
		if def.Tier == tier then
			table.insert(result, def)
		end
	end
	return result
end

function Module.GetBestWeaponForTier(inventory: { [string]: boolean }, maxTier: number): WeaponDef
	local best: WeaponDef = WeaponsConfig["w_0"]
	for id, owned in pairs(inventory) do
		if owned then
			local def = WeaponsConfig[id]
			if def and def.Tier <= maxTier then
				if def.BaseDamage > best.BaseDamage then
					best = def
				end
			end
		end
	end
	return best
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">ZonesConfig</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(script.Parent.Parent.Types)

export type ZoneDef = {
	Id: Types.ZoneId,
	Index: number,
	Name: string,
	Tier: number,
	MaxZoneDamage: number,
	AssociatedMachineId: Types.MachineId,
	Center: Vector3,
	Size: Vector3,
	GateId: string?,
	SpawnPosition: Vector3,
	PadPosition: Vector3,
	MachinePosition: Vector3,
	ChamberPosition: Vector3,
}

local ZonesConfig: { [string]: ZoneDef } = {
	Zone_1 = {
		Id = "Zone_1",
		Index = 1,
		Name = "Zona 1: Novatos",
		Tier = 1,
		MaxZoneDamage = 15,
		AssociatedMachineId = 1,
		Center = Vector3.new(0, 5, 0),
		Size = Vector3.new(120, 26, 140),
		GateId = "Gate_1_2",
		SpawnPosition = Vector3.new(-35, 3, -40),
		PadPosition = Vector3.new(0, 1, -15),
		MachinePosition = Vector3.new(0, 5, 35),
		ChamberPosition = Vector3.new(0, -180, 0),
	},
	Zone_2 = {
		Id = "Zone_2",
		Index = 2,
		Name = "Zona 2: Intermedio",
		Tier = 2,
		MaxZoneDamage = 25,
		AssociatedMachineId = 2,
		Center = Vector3.new(170, 5, 0),
		Size = Vector3.new(120, 26, 140),
		GateId = "Gate_2_3",
		SpawnPosition = Vector3.new(135, 3, -40),
		PadPosition = Vector3.new(170, 1, -15),
		MachinePosition = Vector3.new(170, 5, 35),
		ChamberPosition = Vector3.new(170, -180, 0),
	},
	Zone_3 = {
		Id = "Zone_3",
		Index = 3,
		Name = "Zona 3: Avanzado",
		Tier = 3,
		MaxZoneDamage = 40,
		AssociatedMachineId = 3,
		Center = Vector3.new(340, 5, 0),
		Size = Vector3.new(120, 26, 140),
		GateId = "Gate_3_4",
		SpawnPosition = Vector3.new(305, 3, -40),
		PadPosition = Vector3.new(340, 1, -15),
		MachinePosition = Vector3.new(340, 5, 35),
		ChamberPosition = Vector3.new(340, -180, 0),
	},
	Zone_4 = {
		Id = "Zone_4",
		Index = 4,
		Name = "Zona 4: Experto",
		Tier = 4,
		MaxZoneDamage = 65,
		AssociatedMachineId = 4,
		Center = Vector3.new(510, 5, 0),
		Size = Vector3.new(120, 26, 140),
		GateId = "Gate_4_5",
		SpawnPosition = Vector3.new(475, 3, -40),
		PadPosition = Vector3.new(510, 1, -15),
		MachinePosition = Vector3.new(510, 5, 35),
		ChamberPosition = Vector3.new(510, -180, 0),
	},
	Zone_5 = {
		Id = "Zone_5",
		Index = 5,
		Name = "Zona 5: Cumbre / Coliseo",
		Tier = 5,
		MaxZoneDamage = 100,
		AssociatedMachineId = 5,
		Center = Vector3.new(700, 5, 0),
		Size = Vector3.new(160, 32, 170),
		GateId = nil,
		SpawnPosition = Vector3.new(650, 3, -45),
		PadPosition = Vector3.new(700, 1, -20),
		MachinePosition = Vector3.new(700, 5, 45),
		ChamberPosition = Vector3.new(700, -180, 0),
	},
}

local ZonesOrdered: { ZoneDef } = {
	ZonesConfig["Zone_1"],
	ZonesConfig["Zone_2"],
	ZonesConfig["Zone_3"],
	ZonesConfig["Zone_4"],
	ZonesConfig["Zone_5"],
}

local Module = {
	Zones = ZonesConfig,
	Ordered = ZonesOrdered,
}

function Module.GetByIndex(index: number): ZoneDef?
	return ZonesOrdered[index]
end

function Module.GetById(id: Types.ZoneId): ZoneDef?
	return ZonesConfig[id]
end

function Module.GetByMachineId(machineId: Types.MachineId): ZoneDef?
	return ZonesOrdered[machineId]
end

function Module.GetZoneFromPosition(pos: Vector3): Types.ZoneId
	if pos.X < 85 then
		return "Zone_1"
	elseif pos.X < 255 then
		return "Zone_2"
	elseif pos.X < 425 then
		return "Zone_3"
	elseif pos.X < 595 then
		return "Zone_4"
	else
		return "Zone_5"
	end
end

function Module.GetPlayerZone(player: Player): Types.ZoneId?
	local ok, char = pcall(function()
		return player.Character
	end)
	if not ok or typeof(char) ~= "Instance" or not char:IsA("Model") then
		return nil
	end

	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end

	return Module.GetZoneFromPosition(root.Position)
end

return Module
]]></string>
