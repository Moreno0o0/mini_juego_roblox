        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">WeaponsConfig</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(script.Parent.Parent.Types)

export type WeaponType = "Melee" | "Ranged"

export type WeaponDef = {
	Id: Types.WeaponId,
	Name: string,
	Tier: number,
	Type: WeaponType,
	BaseDamage: number,
	Cooldown: number,
	Range: number,
	Knockback: number,
	Prerequisites: { [string]: boolean },
	ProjectileSpeed: number?,
	Pellets: number?,
	Description: string,
}

local WeaponsConfig: { [string]: WeaponDef } = {
	w_0 = {
		Id = "w_0",
		Name = "Puños",
		Tier = 1,
		Type = "Melee",
		BaseDamage = 8,
		Cooldown = 0.5,
		Range = 4,
		Knockback = 12,
		Prerequisites = {},
		Description = "Ataque básico sin armas. Disponible para todos.",
	},
	w_1 = {
		Id = "w_1",
		Name = "Bate de Madera",
		Tier = 1,
		Type = "Melee",
		BaseDamage = 14,
		Cooldown = 0.8,
		Range = 6,
