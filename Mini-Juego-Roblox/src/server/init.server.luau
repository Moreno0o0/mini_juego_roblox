--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Network = require(ReplicatedStorage.Shared.Network)
local CollisionManager = require(ServerScriptService.Server.CollisionManager)
local WorldBuilder = require(ServerScriptService.Server.WorldBuilder)
local WeaponAssetFactory = require(ServerScriptService.Server.WeaponAssetFactory)
local PlayerStateService = require(ServerScriptService.Server.PlayerStateService)
local ProgressionService = require(ServerScriptService.Server.ProgressionService)
local InventoryService = require(ServerScriptService.Server.InventoryService)
local CombatSystem = require(ServerScriptService.Server.CombatSystem)
local MachineManager = require(ServerScriptService.Server.MachineManager)
local MinigameValidators = require(ServerScriptService.Server.MinigameValidators)
local SecurityValidator = require(ServerScriptService.Server.SecurityValidator)
local DataService = require(ServerScriptService.Server.DataService)
local ShopService = require(ServerScriptService.Server.ShopService)
local StreakService = require(ServerScriptService.Server.StreakService)
local ArenaEventManager = require(ServerScriptService.Server.ArenaEventManager)

print("[SERVER] Initializing competitive minigame server...")

Network.InitializeRemotes()
SecurityValidator.Init()
DataService.Init()
CollisionManager.Init()
WorldBuilder.BuildWorld()
WeaponAssetFactory.BuildWeapons()
PlayerStateService.Init()
ProgressionService.Init()
InventoryService.Init()
CombatSystem.Init()
MachineManager.Init()
MinigameValidators.Init()
ShopService.Init()
StreakService.Init()
ArenaEventManager.Init()

print("[SERVER] All systems initialized successfully.")
